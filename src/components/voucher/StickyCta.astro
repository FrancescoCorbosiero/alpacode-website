---
/* Sticky CTA pill — appears once the hero is gone, steps aside while
   anything marked [data-sticky-hide] is on screen: the form (and after the
   form has done its job), the finale that repeats the same call, the
   terms' fine print. Behaviour: lib/sticky.ts. */
interface Props {
  label: string;
  href: string;
}
const { label, href } = Astro.props;
---

<div class="rf-sticky" data-sticky>
  <a class="rf-sticky-btn" href={href}>{label} <span class="arrow" aria-hidden="true">→</span></a>
</div>

<script>
  import "../../lib/sticky.ts";
</script>
