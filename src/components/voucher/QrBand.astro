---
/* The flyer's dark QR band: "Scansiona il QR code …", "oppure visita
   alpacode.it/voucher", the alpaca and the handwritten campaign line. On
   the web the QR opens this very page (handy to carry on from a phone, or
   to show to someone across the table); once a personal link exists the
   script swaps in a QR of the invite itself. The QR prints itself in when
   the band scrolls in (data-print); the alpaca is alive. */
import type { Lang } from "../../i18n/types";
import { shared } from "../../data/voucher/shared";
import { programPath, type ProgramId } from "../../lib/voucher/program";
import { qrSvg } from "../../lib/voucher/qr";
import Icon from "./Icon.astro";
import Alpaca from "../Alpaca.astro";
import HandLine from "./HandLine.astro";

interface Props {
  lang: Lang;
  program: ProgramId;
}
const { lang, program } = Astro.props;
const c = shared[lang].qr;
const site = (Astro.site?.href ?? "https://alpacode.it/").replace(/\/$/, "");
const path = programPath(program, lang);
const svg = qrSvg(`${site}${path}#segnala`, { label: c.qrAlt });
// What to type on a phone: the door's short address, no scheme, no slash.
const address = `${new URL(site).host}${path.replace(/\/$/, "")}`;
---

<section class="rf-qr-sec" aria-labelledby="qr-title">
  <div class="wrap-wide">
    <div class="rf-qr-band" data-qr-band>
      <div class="rf-qr-tile" data-qr-tile data-print set:html={svg} />
      <div class="rf-qr-copy">
        <h2 class="rf-qr-title" id="qr-title" data-qr-title>{c.title}</h2>
        <p class="rf-qr-body" data-qr-body>{c.body}</p>
        <p class="rf-qr-hint">{c.hint}</p>
        <p class="rf-qr-visit">
          <Icon name="link" size={20} />
          <span>{c.visit}</span>
          <a class="rf-qr-pill" href={`${path}#segnala`}>
            {address} <span class="arrow" aria-hidden="true">→</span>
          </a>
        </p>
      </div>
      <div class="rf-qr-sign" aria-hidden="true">
        <Alpaca class="rf-qr-alpaca" width={92} data-alpaca />
        <HandLine lines={shared[lang].campaignLine} />
      </div>
    </div>
  </div>
</section>
