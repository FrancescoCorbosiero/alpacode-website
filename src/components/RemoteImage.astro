---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Marketing image with a three-tier strategy:
//   1. `local` provided  -> optimized <Image> (WebP/AVIF + srcset). Best.
//   2. else `src` (remote, e.g. Unsplash) -> hotlinked <img>, with a JS
//      onerror fallback to the styled placeholder.
//   3. neither / load fails -> the dashed placeholder box.
// So a missing local file or a blocked remote URL never shows a broken image.
interface Props {
  /** Remote URL (e.g. Unsplash). Used when no local image is supplied. */
  src?: string;
  /** Optimized local asset; takes priority when present. */
  local?: ImageMetadata;
  alt: string;
  /** Shown if nothing can load. */
  placeholder: string;
  class?: string;
  loading?: "lazy" | "eager";
  ratio?: string;
}
const {
  src,
  local,
  alt,
  placeholder,
  class: cls,
  loading = "lazy",
  ratio = "4 / 3",
} = Astro.props;
---

<div class:list={["img-slot", "remote-slot", cls]} style={`--ratio:${ratio}`}>
  {
    local ? (
      <Image
        src={local}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 920px) 100vw, 45vw"
        loading={loading}
        class="img-fill"
      />
    ) : (
      <img
        src={src}
        alt={alt}
        loading={loading}
        decoding="async"
        class="img-fill"
        data-remote-img
        data-placeholder={placeholder}
      />
    )
  }
  <span class="remote-fallback" aria-hidden="true">{placeholder}</span>
</div>

<script>
  // Swap to the dashed placeholder if a remote image fails to load. Runs once;
  // safe across View Transitions navigations.
  function wireRemoteImages() {
    document
      .querySelectorAll<HTMLImageElement>("img[data-remote-img]")
      .forEach((img) => {
        if (img.dataset.wired) return;
        img.dataset.wired = "1";
        const fail = () => img.closest(".remote-slot")?.classList.add("img-failed");
        if (img.complete && img.naturalWidth === 0) fail();
        img.addEventListener("error", fail);
      });
  }
  document.addEventListener("astro:page-load", wireRemoteImages);
  wireRemoteImages();
</script>
