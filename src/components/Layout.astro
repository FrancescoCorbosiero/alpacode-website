---
import "@fontsource/archivo-black/400.css";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/500.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/manrope/800.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";
import type { Lang } from "../i18n/types";
import type { PageKey } from "../data/pages";
import { PAGES } from "../data/pages";
import { localizePath } from "../i18n/utils";
import { ui, cmdk, footer } from "../i18n/ui";
import { business, tagline } from "../data/business";
import { CAL_CONFIGURED, CAL_ORIGIN } from "../lib/calcom";
import { organizationSchema, websiteSchema } from "../lib/schema";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingActions from "./FloatingActions.astro";
import CalEmbed from "./CalEmbed.astro";
import Analytics from "./Analytics.astro";
import CmdK from "./islands/CmdK.tsx";
import type { CmdItem, CmdLabels } from "./islands/CmdK";

interface Props {
  lang: Lang;
  active?: PageKey;
  slug: string;
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
  ogImage?: string;
  /** Intrinsic size of the og:image. The defaults describe the standard
   *  1200×630 cards (tools/og); override when passing a custom image. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Open Graph object type — "article" for blog posts. */
  ogType?: "website" | "article";
  /** Browser-chrome color override for pages that are dark in both schemes
   *  (the bespoke landings paint their own ink background). */
  themeColor?: string;
  /** Conversion-focused chrome: minimal header, slim footer, no ⌘K palette.
   *  Used by advertising landing pages to cut exits. */
  minimal?: boolean;
  /** Minimal-mode header CTA. */
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  lang,
  active,
  slug,
  title,
  description,
  jsonLd,
  noindex,
  ogImage: ogImageProp,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = "website",
  themeColor,
  minimal = false,
  ctaLabel,
  ctaHref = "#offerta",
} = Astro.props;

const homeHref = localizePath("", lang);
const itHref = localizePath(slug, "it");
const enHref = localizePath(slug, "en");

const learningHref = localizePath("learning", lang);
const prenotaHref = localizePath("prenota", lang);

const site = Astro.site ?? new URL("https://alpacode.it");
const canonical = new URL(Astro.url.pathname, site).href;
const itUrl = new URL(localizePath(slug, "it"), site).href;
const enUrl = new URL(localizePath(slug, "en"), site).href;
// Link previews (WhatsApp, Facebook, LinkedIn…) don't render SVG, so og
// images are pre-rasterised PNGs — see tools/og/render.mjs.
const ogImage = ogImageProp
  ? new URL(ogImageProp, site).href
  : new URL("/og-default.png", site).href;
const rssHref = localizePath("blog/rss.xml", lang);

const ldJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [organizationSchema(site.href), websiteSchema(site.href, lang), ...(jsonLd ?? [])],
});

const cmdItems: CmdItem[] = [
  ...PAGES.map((p) => ({
    kind: "page" as const,
    num: p.num,
    ttl: p.label[lang],
    sub: `${lang === "it" ? "Pagina" : "Page"} · ${localizePath(p.slug, lang)}`,
    href: localizePath(p.slug, lang),
  })),
  { kind: "course", num: "C1", ttl: "WordPress Gutenberg", sub: lang === "it" ? "Corso · 24h" : "Course · 24h", href: learningHref },
  { kind: "course", num: "C2", ttl: "WordPress with Sage Theme", sub: lang === "it" ? "Corso · 20h" : "Course · 20h", href: learningHref },
  { kind: "course", num: "C3", ttl: "Advanced Java with Spring Boot", sub: lang === "it" ? "Corso · 32h" : "Course · 32h", href: learningHref },
  { kind: "course", num: "C4", ttl: lang === "it" ? "WordPress + AI" : "WordPress + AI", sub: lang === "it" ? "Corso · 12h" : "Course · 12h", href: learningHref },
  { kind: "action", num: "→", ttl: cmdk.bookCall[lang], sub: cmdk.bookCallSub[lang], href: prenotaHref },
  { kind: "action", num: "✉", ttl: business.email, sub: cmdk.email[lang], href: `mailto:${business.email}` },
  { kind: "action", num: "⌘", ttl: cmdk.switchLang[lang], sub: cmdk.switchLangSub[lang], action: "lang" },
];

const cmdLabels: CmdLabels = {
  searchLabel: cmdk.searchLabel,
  placeholder: ui.search[lang],
  esc: cmdk.esc,
  sections: {
    recent: cmdk.recent[lang],
    page: cmdk.pages[lang],
    course: cmdk.courses[lang],
    action: cmdk.actions[lang],
  },
  navigate: cmdk.navigate[lang],
  open: cmdk.open[lang],
  close: cmdk.close[lang],
  empty: cmdk.empty[lang],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Monogram icon set (tools/icons) — the wordmark logo is illegible at tab size. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      themeColor ? (
        <meta name="theme-color" content={themeColor} />
      ) : (
        <>
          <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F4F1E8" />
          <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#12110F" />
        </>
      )
    }

    <link rel="alternate" hreflang="it" href={itUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={itUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Alpacode · Soluzioni Digitali" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="generator" content={Astro.generator} />

    {CAL_CONFIGURED && <link rel="preconnect" href={CAL_ORIGIN} crossorigin />}

    <link rel="alternate" type="application/rss+xml" title="Alpacode · Blog" href={rssHref} />
    <script type="application/ld+json" is:inline set:html={ldJson} />

    <ClientRouter />
  </head>
  <body data-page={active ?? "404"}>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{ui.skip[lang]}</a>
    {
      minimal ? (
        <header class="site-header campaign-header">
          <div class="header-strut" />
          <div class="header-row">
            <a class="brand" href={homeHref} aria-label="Alpacode — home">
              <span class="brand-mark">
                <span class="brand-name">ALPACODE</span>
                <span class="brand-strut" aria-hidden="true" />
              </span>
            </a>
            <div class="nav-actions">
              <a class="campaign-lang" href={lang === "it" ? enHref : itHref}>
                {lang === "it" ? "EN" : "IT"}
              </a>
              <a class="btn btn-blue btn-sm" href={ctaHref}>
                {ctaLabel ?? ui.cta[lang]} <span class="arrow">→</span>
              </a>
            </div>
          </div>
        </header>
      ) : (
        <Header lang={lang} active={active} slug={slug} />
      )
    }
    <main id="main">
      <slot />
    </main>
    {
      minimal ? (
        <footer class="site-footer campaign-footer">
          <div class="footer-strut" />
          <div class="wrap-wide">
            <div class="campaign-foot-row">
              <span class="campaign-foot-brand">ALPACODE</span>
              <span class="campaign-foot-tag">{tagline[lang]}</span>
              <span class="campaign-foot-links">
                <a href={`mailto:${business.email}`}>{business.email}</a>
                <a href={localizePath("privacy", lang)}>{footer.privacy[lang]}</a>
                <a href={localizePath("cookie", lang)}>{footer.cookies[lang]}</a>
                <a href={localizePath("termini", lang)}>{footer.terms[lang]}</a>
              </span>
            </div>
            <div class="footer-bottom">
              <span>{footer.rights[lang]}</span>
              <span>{footer.bottomLocation}</span>
            </div>
          </div>
        </footer>
      ) : (
        <Footer lang={lang} />
      )
    }
    <FloatingActions lang={lang} />
    {!minimal && <CmdK client:idle lang={lang} items={cmdItems} labels={cmdLabels} />}
    {CAL_CONFIGURED && <CalEmbed />}
    <Analytics />
    <div id="cc-root" transition:persist></div>

    <script>
      import "../lib/motion.ts";
      import "../lib/consent.ts";
    </script>
  </body>
</html>
