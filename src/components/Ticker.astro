---
interface Props {
  items: string[];
  /** "band" — the slim ink strip (default). "xl" — display-size words on
   *  paper that follow the scroll (speed and direction, see motion.ts). */
  variant?: "band" | "xl";
}
const { items, variant = "band" } = Astro.props;
// Duplicate the set so the loop can wrap seamlessly at -50%.
const loop = [...items, ...items];
---

<div class:list={["ticker", { "ticker--xl": variant === "xl" }]} aria-hidden="true" style={`--items:${items.length}`}>
  <div class="ticker-track">
    {
      loop.map((t) => (
        <span class="ticker-item">
          <span class="tick" aria-hidden="true" />
          {t}
        </span>
      ))
    }
  </div>
</div>
