---
import Alpaca from "./Alpaca.astro";

interface Props {
  items: string[];
  /** "band" — the slim ink strip (default). "xl" — display-size words on
   *  paper that follow the scroll (speed and direction: the marquee
   *  effect). Without the script, and on a plain band, the CSS drifts it. */
  variant?: "band" | "xl";
  /** Band only: follow the scroll like the xl marquee does (the referral
   *  pages, whose alpaca walks with the words). */
  follow?: boolean;
  /** Alpacas in place of a tick, per set (true = 1): they walk along with
   *  the words and turn round when they do (the alpaca effect rides the
   *  marquee). Evenly spaced from the second item, so the first is
   *  mid-screen when the band arrives. */
  alpaca?: boolean | number;
}
const { items, variant = "band", follow = false, alpaca = false } = Astro.props;
// Duplicate the set so the loop can wrap seamlessly at -50%.
const loop = [...items, ...items];
const herd = Math.min(Number(alpaca), items.length);
const follows = variant === "xl" || follow;
const walkers = new Set(Array.from({ length: herd }, (_, k) => (1 + Math.floor((k * items.length) / herd)) % items.length));
---

<div
  class:list={["ticker", { "ticker--xl": variant === "xl", "ticker--follow": follow && variant !== "xl" }]}
  aria-hidden="true"
  style={`--items:${items.length}`}
  data-marquee={follows ? "" : undefined}
  data-marquee-speed={follows && variant !== "xl" ? "56" : undefined}
>
  <div class="ticker-track" data-marquee-track>
    {
      loop.map((t, i) => {
        const walker = walkers.has(i % items.length);
        return (
          <span class:list={["ticker-item", { "ticker-item--alpaca": walker }]}>
            {walker ? <Alpaca class="ticker-alpaca" width={64} data-alpaca-walker /> : <span class="tick" aria-hidden="true" />}
            {t}
          </span>
        );
      })
    }
  </div>
</div>
