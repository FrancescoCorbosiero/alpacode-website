---
/* Metodo — «Come si parte.»: the four steps on a departures board.
   The board (ink, square split flaps) shows the step on stage in its
   top row (its number and its destination in the big flaps, its note
   in the board's blue) and the steps to come under it. On a pinned
   stage the method scene ([data-scene="method"]) flips it as the
   visitor scrolls: a step departs, the next rolls up to the top row,
   the step's text hands over beside it. Laid out (no script, reduced
   motion) it's the whole board, every step on it, beside the four
   steps. */
import type { Lang } from "../../i18n/types";
import { process } from "../../data/home";
import BookCall from "../BookCall.astro";
import Br from "../Br.astro";
import Flaps from "./Flaps.astro";

interface Props {
  lang: Lang;
  /** On sub-pages, drop the home section number from the eyebrow. */
  bare?: boolean;
}
const { lang, bare = false } = Astro.props;
const t = process[lang];
const num = bare ? t.num.replace(/^\d+\s*·\s*/, "") : t.num;
const bookLabel = lang === "it" ? "Prenota la prima call" : "Book the first call";

/** The destination's flaps: as many as the longest destination needs. */
const TO = 8;
const [first, ...rest] = t.steps;
---

<section class="section section--tint process">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num">{num}</div>
        <h2><Br text={t.heading} /></h2>
      </div>
      <p class="lede">{t.lede}</p>
    </div>
  </div>

  <div class="method-scene" data-scene="method" style="--len:4.2">
    <div class="method-stage" data-scene-stage>
      <div class="wrap-wide">
        <div class="method">
          <div class="board" data-board aria-hidden="true">
            <div class="board-in">
              <div class="board-head">
                <span class="board-title"><i class="board-dot" data-board-dot></i>{t.board.title}</span>
                <span>{t.board.from}</span>
              </div>
              <div class="board-cols">
                <span class="board-col-no">{t.board.step}</span>
                <span>{t.board.to}</span>
              </div>
              {
                first && (
                  <div class="board-now" data-board-row>
                    <span class="board-no">
                      <Flaps word={first.n} n={2} />
                    </span>
                    <span class="board-to">
                      <Flaps word={first.to} n={TO} />
                    </span>
                    <span class="board-note" data-board-note>{first.note}</span>
                  </div>
                )
              }
              <div class="board-next">
                <span class="board-label">{t.board.next}</span>
                <ol>
                  {
                    rest.map((s) => (
                      <li class="board-row" data-board-row>
                        <span class="board-no">
                          <Flaps word={s.n} n={2} />
                        </span>
                        <span class="board-to">
                          <Flaps word={s.to} n={TO} />
                        </span>
                        <span class="board-note" data-board-note>{s.note}</span>
                      </li>
                    ))
                  }
                </ol>
              </div>
            </div>
          </div>
          <ol class="method-steps">
            {
              t.steps.map((s) => (
                <li class="method-text" data-method-text data-no={s.n} data-to={s.to} data-note={s.note}>
                  <span class="method-no">{s.n}</span>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="method-rail" data-method-rail hidden aria-hidden="true"><i></i></div>
      </div>
    </div>
  </div>

  <div class="wrap-wide">
    <div class="band-cta">
      <BookCall label={bookLabel} journey="process" lang={lang} class="btn-blue" />
    </div>
  </div>
</section>
