---
import type { Lang } from "../../i18n/types";
import { verbs } from "../../data/home";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = verbs[lang];
---

<section class="section">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num">{t.num}</div>
        <h2 style="white-space:pre-line">{t.heading}</h2>
      </div>
      <p class="lede">{t.lede}</p>
    </div>
    <div class="verbs">
      {
        t.list.map((v) => (
          <div class="verb">
            <div class="v-num">— {v.num}</div>
            <div class="v-word">{v.word.slice(0, v.word.length - v.accent.length)}<span class="accent">{v.accent}</span></div>
            <div class="v-strut"></div>
            <div class="v-desc">{v.d}</div>
            <ul>
              {v.items.map((i) => (
                <li><span>{i}</span></li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
