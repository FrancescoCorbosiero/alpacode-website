---
import type { Lang } from "../../i18n/types";
import { ctaFinal } from "../../data/home";
import { localizePath } from "../../i18n/utils";
import BookCall from "../BookCall.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ctaFinal[lang];
const contattiHref = localizePath("contatti", lang);
const bookLabel = lang === "it" ? "Prenota una call" : "Book a call";

const resolve = (href?: string) => {
  if (!href) return undefined;
  if (href.startsWith("mailto:") || href.startsWith("http")) return href;
  return localizePath(href, lang);
};
---

<section class="cta-final">
  <div class="wrap-wide">
    <p class="sec-num">{t.num}</p>
    <div class="display">
      {t.line1}<br /><span class="underline">{t.underline}</span>
    </div>
    <div class="sub">{t.sub}</div>
    <div class="cta-grid">
      {
        t.grid.map((g) => {
          const href = resolve(g.href);
          return (
            <div class="cell">
              <span class="k">{g.k}</span>
              {href ? (
                <a href={href}><span class="v">{g.v} →</span></a>
              ) : (
                <span class="v">{g.v}</span>
              )}
            </div>
          );
        })
      }
    </div>
    <div class="cta-final-actions">
      <BookCall label={bookLabel} journey="cta-final" lang={lang} class="btn-blue" />
      <a class="btn btn-ghost" href={contattiHref}>{t.cta}</a>
    </div>
  </div>
</section>
