---
import type { Lang } from "../../i18n/types";
import { pitch } from "../../data/home";
import { localizePath } from "../../i18n/utils";
import BookCall from "../BookCall.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pitch[lang];
const prodottiHref = localizePath("prodotti", lang);
const bookLabel = lang === "it" ? "Prenota una call gratuita" : "Book a free call";
const seeProducts = lang === "it" ? "Guarda i pacchetti pronti" : "See the ready packages";
---

<section class="section pitch">
  <div class="wrap-wide">
    <div class="sec-num">{t.num}</div>
    <h2 class="pitch-lead">{t.lead}</h2>
    <p class="pitch-intro">{t.intro}</p>

    <div class="pitch-turn">
      <p class="pitch-objection">{t.objection}</p>
      <p class="pitch-answer"><span class="hl">{t.answer}</span></p>
    </div>

    <div class="pitch-foot">
      <p class="pitch-body">{t.body}</p>
      <ul class="pitch-chips">
        {t.chips.map((c) => <li>{c}</li>)}
      </ul>
    </div>

    <div class="pitch-cta">
      <BookCall label={bookLabel} journey="pitch" lang={lang} class="btn-blue" />
      <a class="btn btn-ghost" href={prodottiHref}>{seeProducts} <span class="arrow">→</span></a>
    </div>
  </div>
</section>
