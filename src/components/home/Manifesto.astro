---
import type { Lang } from "../../i18n/types";
import { manifesto } from "../../data/home";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = manifesto[lang];
---

<section class="manifesto">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num">{t.num}</div>
        <h2 style="white-space:pre-line">{t.heading}</h2>
      </div>
      <p class="lede">{t.lede}</p>
    </div>
    <div class="pillars">
      {
        t.pillars.map((p) => (
          <div class="pillar">
            <div class="p-num">{p.label}</div>
            <div class="p-strut"></div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))
      }
    </div>
    <div class="manifesto-sig">
      <span class="manifesto-sig-bar" aria-hidden="true"></span>
      <span class="manifesto-sig-name">{t.sig.name}</span>
      <span class="manifesto-sig-role">{t.sig.role}</span>
    </div>
  </div>
</section>
