---
import type { Lang } from "../../i18n/types";
import { manifesto } from "../../data/home";
import Br from "../Br.astro";
import Alpaca from "../Alpaca.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = manifesto[lang];
---

<section class="manifesto">
  {/* The studio's beliefs, and the animal in the name: a silhouette in the
      ink, a shade off the band, standing on its lower edge. It walks in
      from the dark when the band is well in view (motion.ts). */}
  <Alpaca class="manifesto-alpaca" width={420} data-alpaca="walk-in" />
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num">{t.num}</div>
        <h2><Br text={t.heading} /></h2>
      </div>
      <p class="lede">{t.lede}</p>
    </div>
    <div class="pillars">
      {
        t.pillars.map((p) => (
          <div class="pillar">
            <div class="p-num">{p.label}</div>
            <div class="p-strut"></div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))
      }
    </div>
    <div class="manifesto-sig">
      <span class="manifesto-sig-bar" aria-hidden="true"></span>
      <span class="manifesto-sig-name">{t.sig.name}</span>
      <span class="manifesto-sig-role">{t.sig.role}</span>
    </div>
  </div>
</section>
