---
import type { Lang } from "../../i18n/types";
import { hero, heroVideo } from "../../data/home";
import { localizePath } from "../../i18n/utils";
import BookCall from "../BookCall.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = hero[lang];
const lavoriHref = localizePath("lavori", lang);
const video = heroVideo;

/* "Digitalizziamo *privati*" → text + highlighted segments. */
const segments = (line: string) =>
  line.split(/(\*[^*]+\*)/).filter(Boolean).map((part) =>
    part.startsWith("*") ? { em: true, text: part.slice(1, -1) } : { em: false, text: part },
  );
---

<section class:list={["hero", { "hero--video": video }]} data-hero>
  {
    video && (
      <div class="hero-media" aria-hidden="true">
        {/* Sources are attached by motion.ts only when motion is welcome and
            the connection isn't on Save-Data; otherwise the poster stays. */}
        <video class="hero-video" muted loop playsinline preload="none" poster={video.poster} data-hero-video>
          {video.webm && <source data-src={video.webm} type="video/webm" />}
          <source data-src={video.mp4} type="video/mp4" />
        </video>
        <div class="hero-scrim" />
      </div>
    )
  }

  <div class="wrap-wide hero-inner" data-hero-content>
    <p class:list={["label", { "label--on-ink": video }]} data-intro>{t.kicker}</p>

    {/* The wordmark below is brand furniture (and Italian-only), so the h1
        is the localized claim. Each line is its own mask for the intro. */}
    <h1 class="hero-claim intro-lines">
      {
        t.claim.map((line) => (
          <span class="line">
            <span>
              {segments(line).map((s) => (s.em ? <em>{s.text}</em> : s.text))}
            </span>
          </span>
        ))
      }
    </h1>

    <div class="hero-row" data-intro>
      <p class="hero-lede">{t.lede}</p>
      <div class="hero-ctas">
        <BookCall label={t.cta1} journey="hero" lang={lang} class="btn-blue" />
        <a class:list={["btn", video ? "btn-on-ink" : "btn-ghost"]} href={lavoriHref}>{t.cta2} <span class="arrow">→</span></a>
      </div>
    </div>
  </div>

  <div class="wrap-wide hero-lockup" aria-hidden="true" data-hero-lockup>
    <div class="hero-wordmark">
      <div class="row row-1"><span>ALPACODE</span></div>
      <div class="hero-bar"></div>
      <div class="row row-2"><span>SOLUZIONI</span><span>DIGITALI</span></div>
    </div>
  </div>
</section>
