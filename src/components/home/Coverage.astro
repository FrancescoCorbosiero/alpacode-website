---
/* Dove operiamo — Italy in dots, the base between Monza and Milano,
   an arc to every place where a client is (src/data/places.ts, read
   from the work entries), a lighter arc of reach to Torino, Roma and
   Napoli, a faint city for every region; and beside
   it, with the same weight, the sheet: base, reach, the clients by
   place (each name opens its case), the call. One screen tall on a
   desktop. The map scene ([data-scene="map"]) spreads the dots out
   from the base and draws the arcs as the section comes in; laid out,
   the map is whole. */
import type { Lang } from "../../i18n/types";
import { coverage } from "../../data/home";
import { BASE, LOCAL, PLACES, PLACE_IDS, REFERENCES, type PlaceId } from "../../data/places";
import { works, workHref } from "../../data/work";
import { arc, dotPath, mapBox, project } from "../../lib/italy-dots";
import BookCall from "../BookCall.astro";
import Br from "../Br.astro";

interface Props {
  lang: Lang;
  /** On sub-pages, drop the home section number from the eyebrow. */
  bare?: boolean;
}
const { lang, bare = false } = Astro.props;
const t = coverage[lang];
const num = bare ? t.num.replace(/^\d+\s*·\s*/, "") : t.num;

const list = await works();
const byPlace = PLACE_IDS.map((id) => [id, list.filter((w) => w.data.place === id)] as const).filter(
  ([, ws]) => ws.length > 0,
);
const dots = dotPath();
const base = project(PLACES[BASE].lat, PLACES[BASE].lon);
const at = (id: PlaceId) => project(PLACES[id].lat, PLACES[id].lon);
// The far places get an arc and a label; the near ones are the cluster
// round the base, named by its label.
const far = byPlace.filter(([id]) => !LOCAL.includes(id)).map(([id]) => ({ id, ...at(id) }));
// A city for every region, faint, to orient the map (not clients); the
// hubs among them get an arc of reach and a label of their own.
const refs = REFERENCES.filter((r) => !r.hub).map((r) => ({ ...r, ...project(r.lat, r.lon) }));
const hubs = REFERENCES.filter((r) => r.hub).map((r) => ({
  ...r,
  id: r.name.en.toLowerCase(),
  ...project(r.lat, r.lon),
}));
// Every arc, nearest first: the map scene draws them in this order.
const far2 = (p: { x: number; y: number }) => (p.x - base.x) ** 2 + (p.y - base.y) ** 2;
const arcs = [
  ...far.map((p) => ({ id: p.id as string, x: p.x, y: p.y, reach: false })),
  ...hubs.map((h) => ({ id: h.id, x: h.x, y: h.y, reach: true })),
].sort((a, b) => far2(a) - far2(b));
const near = byPlace.filter(([id]) => LOCAL.includes(id) && id !== BASE).map(([id]) => ({ id, ...at(id) }));
---

<section class="section coverage" data-scene="map">
  <div class="wrap-wide coverage-grid">
    <figure class="map-figure">
      <svg
        class="map"
        viewBox={`0 0 ${mapBox.w} ${mapBox.h}`}
        role="img"
        aria-label={lang === "it"
          ? `Mappa dell'Italia: la base tra Monza e Milano, clienti a ${byPlace.map(([id]) => PLACES[id].name.it).join(", ")}; da remoto anche verso ${hubs.map((h) => h.name.it).join(", ")} e tutte le regioni`
          : `Map of Italy: based between Monza and Milan, clients in ${byPlace.map(([id]) => PLACES[id].name.en).join(", ")}; remotely also to ${hubs.map((h) => h.name.en).join(", ")} and every region`}
      >
        <defs>
          {/* The reach the map scene spreads out from the base. */}
          <radialGradient id="map-reach-fade">
            <stop offset="0.82" stop-color="#fff" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </radialGradient>
          <mask id="map-reach" maskUnits="userSpaceOnUse" x="0" y="0" width={mapBox.w} height={mapBox.h}>
            <circle data-map-reach cx={base.x} cy={base.y} r={Math.hypot(mapBox.w, mapBox.h)} fill="url(#map-reach-fade)" />
          </mask>
        </defs>

        <path class="map-dots" d={dots.d} data-map-dots />

        <g class="map-arcs">
          {
            arcs.map((a) => (
              <path class:list={["map-arc", a.reach && "map-arc--reach"]} d={arc(base, a)} pathLength="1" data-map-arc={a.id} />
            ))
          }
        </g>

        {/* Over the arcs: a faint city's name stays legible where an arc
            passes it. */}
        <g class="map-refs" data-map-refs aria-hidden="true">
          {
            refs.map((r) => (
              <g class="map-ref">
                <circle class="map-ref-pt" cx={r.x} cy={r.y} r="2" />
                <text
                  class="map-ref-label"
                  x={r.side === "right" ? r.x + 6 : r.x - 6}
                  y={r.y + 3.5}
                  text-anchor={r.side === "right" ? "start" : "end"}
                >
                  {r.name[lang]}
                </text>
              </g>
            ))
          }
        </g>

        <g class="map-places">
          {
            near.map((p) => (
              <g class="map-place" data-map-place={p.id}>
                <circle class="map-pt map-pt--near" cx={p.x} cy={p.y} r="2.2" />
              </g>
            ))
          }
          {
            far.map((p) => (
              <g class="map-place" data-map-place={p.id}>
                <circle class="map-pt" cx={p.x} cy={p.y} r="3.4" />
                <text class="map-label" x={p.x + 8} y={p.y + 4}>
                  {PLACES[p.id].name[lang]}
                </text>
              </g>
            ))
          }
          {
            hubs.map((h) => (
              <g class="map-place map-place--hub" data-map-place={h.id}>
                <circle class="map-pt map-pt--hub" cx={h.x} cy={h.y} r="2.8" />
                <text
                  class="map-hub-label"
                  x={h.side === "right" ? h.x + 7 : h.x - 7}
                  y={h.y + 4}
                  text-anchor={h.side === "right" ? "start" : "end"}
                >
                  {h.name[lang]}
                </text>
              </g>
            ))
          }
        </g>

        <g class="map-base" data-map-base={BASE}>
          <circle class="map-ping" cx={base.x} cy={base.y} r="7" data-map-ping />
          <circle class="map-hq" cx={base.x} cy={base.y} r="4.6" />
          <text class="map-base-label" x={base.x} y={base.y - 14} text-anchor="middle">{t.hqLabel}</text>
        </g>
      </svg>
      <figcaption class="map-key">
        <span class="map-key-item"><i class="map-key-line" aria-hidden="true"></i>{t.keyClients}</span>
        <span class="map-key-item"><i class="map-key-line map-key-line--reach" aria-hidden="true"></i>{t.keyReach}</span>
      </figcaption>
    </figure>

    <div class="coverage-head">
      <div class="sec-num">{num}</div>
      <h2 class="coverage-title" data-split><Br text={t.heading} /></h2>
      <p class="coverage-lede">{t.lede}</p>
    </div>

    <div class="coverage-sheet">
      <dl class="cov-sheet">
        <div class="cov-row">
          <dt>{t.baseLabel}</dt>
          <dd>{t.baseValue}</dd>
        </div>
        <div class="cov-row">
          <dt>{t.reachLabel}</dt>
          <dd>{t.reachValue}</dd>
        </div>
        <div class="cov-row cov-row--clients">
          <dt>{t.clientsLabel}</dt>
          <dd>
            <ul class="cov-clients">
              {
                byPlace.map(([id, ws]) => (
                  <li class="cov-client" data-map-row={id}>
                    <span class="cov-place">{PLACES[id].name[lang]}</span>
                    <span class="cov-names">
                      {ws.map((w) => (
                        <a href={workHref(w.id, lang)}>{w.data.title[lang]}</a>
                      ))}
                    </span>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
      </dl>

      <p class="cov-note">{t.note}</p>
      <BookCall label={t.cta} journey="coverage" lang={lang} class="btn-blue" />
    </div>
  </div>
</section>
