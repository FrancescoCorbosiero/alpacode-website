---
import type { Lang } from "../../i18n/types";
import { coverage } from "../../data/home";
import BookCall from "../BookCall.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = coverage[lang];

const W = 440;
const H = 600;

// Stylized, low-poly Italy — recognizable, not geographically exact.
const mainland =
  "M72,150 L150,94 L262,94 L288,122 L294,170 L314,234 L332,300 L358,326 L338,346 L380,400 L348,412 L308,400 L300,434 L282,474 L266,456 L262,402 L250,332 L236,262 L214,202 L190,166 L150,128 Z";
const sicily = "M206,500 L284,488 L300,518 L236,532 Z";
const sardinia = "M90,348 L120,344 L126,420 L96,426 Z";
const lombardia = "M150,102 L206,94 L222,120 L178,132 L150,120 Z";

const hq = { x: 184, y: 110 };
const cities = [
  { x: 116, y: 122, n: "Torino", anchor: "end" },
  { x: 264, y: 110, n: "Venezia", anchor: "start" },
  { x: 226, y: 212, n: "Firenze", anchor: "start" },
  { x: 250, y: 282, n: "Roma", anchor: "start" },
  { x: 290, y: 326, n: "Napoli", anchor: "start" },
  { x: 350, y: 370, n: "Bari", anchor: "start" },
  { x: 245, y: 500, n: "Palermo", anchor: "start" },
  { x: 108, y: 392, n: "Cagliari", anchor: "end" },
];
const lines = cities.map((c, i) => {
  const dx = c.x - hq.x;
  const dy = c.y - hq.y;
  return { x2: c.x, y2: c.y, len: Math.round(Math.sqrt(dx * dx + dy * dy)), i };
});
---

<section class="section coverage">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num">{t.num}</div>
        <h2 style="white-space:pre-line">{t.heading}</h2>
      </div>
      <p class="lede">{t.lede}</p>
    </div>

    <div class="coverage-grid">
      <figure class="map-figure">
        <svg
          class="map"
          viewBox={`0 0 ${W} ${H}`}
          role="img"
          aria-label={lang === "it" ? "Mappa dell'Italia: base in Lombardia, copertura nazionale" : "Map of Italy: based in Lombardy, nationwide coverage"}
        >
          <path class="map-land" d={mainland} />
          <path class="map-land" d={sicily} />
          <path class="map-land" d={sardinia} />
          <path class="map-region" d={lombardia} />

          {
            lines.map((l) => (
              <line
                class="map-line"
                x1={hq.x}
                y1={hq.y}
                x2={l.x2}
                y2={l.y2}
                pathLength={l.len}
                style={`--len:${l.len};--i:${l.i}`}
              />
            ))
          }

          {cities.map((c) => <circle class="map-city" cx={c.x} cy={c.y} r="2.6" />)}
          {
            cities.map((c) => (
              <text
                class="map-label"
                x={c.anchor === "end" ? c.x - 7 : c.x + 7}
                y={c.y + 3.5}
                text-anchor={c.anchor}
              >
                {c.n}
              </text>
            ))
          }

          <circle class="map-ping" cx={hq.x} cy={hq.y} r="6" />
          <circle class="map-hq" cx={hq.x} cy={hq.y} r="5" />
          <text class="map-hq-label" x={hq.x} y={hq.y - 13} text-anchor="middle">{t.hqLabel}</text>
        </svg>
      </figure>

      <div class="coverage-info">
        <div class="cov-block">
          <span class="k">— {t.baseLabel}</span>
          <span class="v">{t.baseValue}</span>
        </div>
        <div class="cov-block">
          <span class="k">— {t.reachLabel}</span>
          <span class="v">{t.reachValue}</span>
        </div>
        <p class="cov-note">{t.note}</p>
        <BookCall label={t.cta} journey="coverage" lang={lang} class="btn-blue" />
      </div>
    </div>
  </div>
</section>
