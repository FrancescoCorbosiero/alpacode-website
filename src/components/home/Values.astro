---
import type { Lang } from "../../i18n/types";
import { values } from "../../data/home";
import { localizePath } from "../../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = values[lang];
const contattiHref = localizePath("contatti", lang);
const cta = lang === "it" ? "Parliamone" : "Let's talk";
---

<section class="section section--tint values">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num">{t.num}</div>
        <h2 style="white-space:pre-line">{t.heading}</h2>
      </div>
      <p class="lede">{t.lede}</p>
    </div>

    <div class="value-groups">
      {
        t.groups.map((g) => (
          <div class="value-group">
            <div class="value-group-label">— {g.label}</div>
            <div class="value-cards">
              {g.items.map((v, i) => (
                <div class="value">
                  <div class="value-no">{String(i + 1).padStart(2, "0")}</div>
                  <h3>{v.t}</h3>
                  <div class="value-strut" />
                  <p>{v.d}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <div class="band-cta">
      <a class="btn btn-ghost" href={contattiHref}>{cta} <span class="arrow">→</span></a>
    </div>
  </div>
</section>
