---
import type { Lang } from "../i18n/types";
import type { PageKey } from "../data/pages";
import { PAGES } from "../data/pages";
import { localizePath } from "../i18n/utils";
import { ui } from "../i18n/ui";
import { megaByKey } from "../data/mega";
import { CAL_CONFIGURED, CAL_LINK, CAL_NAMESPACE, CAL_CONFIG } from "../lib/calcom";
import Mega from "./Mega.astro";
import BookCall from "./BookCall.astro";
import LangToggle from "./islands/LangToggle.tsx";
import MobileNav from "./islands/MobileNav.tsx";
import type { MobileNavItem, MobileNavLabels } from "./islands/MobileNav";

interface Props {
  lang: Lang;
  active?: PageKey;
  slug: string;
}
const { lang, active, slug } = Astro.props;

const homeHref = localizePath("", lang);
const itHref = localizePath(slug, "it");
const enHref = localizePath(slug, "en");
const contattiHref = localizePath("contatti", lang);

const status = lang === "it" ? "DISPONIBILE · Q3 2026" : "AVAILABLE · Q3 2026";

const mobileNavItems: MobileNavItem[] = PAGES.map((p) => {
  const item: MobileNavItem = {
    num: p.num,
    key: p.key,
    label: p.label[lang],
    href: localizePath(p.slug, lang),
  };
  if (p.mega) {
    const menu = megaByKey(p.mega);
    item.mega = {
      columns: [menu.colA, menu.colB].map((col) => ({
        title: col.title[lang],
        items: col.items.map((it) => ({ n: it.n, t: it.t[lang], d: it.d[lang] })),
      })),
    };
  }
  return item;
});

const mobileNavLabels: MobileNavLabels = {
  title: ui.menuTitle[lang],
  close: ui.menuClose[lang],
  expand: ui.menuExpand[lang],
  collapse: ui.menuCollapse[lang],
  langLabel: ui.langLabel[lang],
  searchOpen: ui.searchOpen[lang],
  ctaLabel: ui.cta[lang],
};
---

<header class="site-header">
  <div class="header-strut"></div>
  <div class="header-row">
    <a class="brand" href={homeHref} aria-label="Alpacode — home">
      <span class="brand-mark">
        <span class="brand-name">ALPACODE</span>
        <span class="brand-strut" aria-hidden="true"></span>
        <span class="brand-meta">
          <span class="status-dot" aria-hidden="true"></span>
          {status}
        </span>
      </span>
    </a>

    <nav class="nav" aria-label="primary">
      {
        PAGES.map((p) => {
          const href = localizePath(p.slug, lang);
          const isActive = p.key === active;
          const cls = "nav-item " + (isActive ? "is-active" : "");
          if (p.mega) {
            return (
              <div class="mega-wrap">
                <a class={cls} href={href} aria-current={isActive ? "page" : undefined}>
                  <span class="num">{p.num}</span>
                  {p.label[lang]}
                  <span class="caret" aria-hidden="true">▾</span>
                </a>
                <Mega menu={megaByKey(p.mega)} lang={lang} />
              </div>
            );
          }
          return (
            <a class={cls} href={href} aria-current={isActive ? "page" : undefined}>
              <span class="num">{p.num}</span>
              {p.label[lang]}
            </a>
          );
        })
      }
    </nav>

    <div class="nav-actions">
      <button class="kbd" data-cmdk-open type="button" aria-label={ui.searchOpen[lang]}>
        <span data-cmd-mod>⌘</span><span>K</span>
      </button>
      <LangToggle client:load lang={lang} itHref={itHref} enHref={enHref} label={ui.langLabel[lang]} />
      <BookCall label={ui.ctaShort[lang]} journey="header" lang={lang} class="btn-sm" />
      <button
        class="mnav-burger"
        type="button"
        data-mobile-nav-open
        aria-label={ui.menuOpen[lang]}
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<MobileNav
  client:load
  lang={lang}
  active={active}
  items={mobileNavItems}
  itHref={itHref}
  enHref={enHref}
  contattiHref={contattiHref}
  cal={{
    configured: CAL_CONFIGURED,
    link: CAL_LINK,
    namespace: CAL_NAMESPACE,
    config: CAL_CONFIG,
  }}
  labels={mobileNavLabels}
/>
