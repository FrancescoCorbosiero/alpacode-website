---
import type { Lang } from "../i18n/types";
import { PAGES } from "../data/pages";
import { CAMPAIGNS, t as tr } from "../data/campaigns";
import { localizePath } from "../i18n/utils";
import { footer } from "../i18n/ui";
import { business, tagline } from "../data/business";
import { CAL_LINK, CAL_NAMESPACE, CAL_CONFIG, CAL_CONFIGURED } from "../lib/calcom";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const prenotaHref = localizePath("prenota", lang);
const contattiHref = localizePath("contatti", lang);
const privacyHref = localizePath("privacy", lang);
const cookieHref = localizePath("cookie", lang);
const terminiHref = localizePath("termini", lang);
const cookiePrefsLabel = lang === "it" ? "Preferenze cookie" : "Cookie preferences";

/* Secondary navigation — the program/marketing pages kept out of the
   primary nav on purpose. This strip is their internal-link home. */
const collabLinks = [
  { href: localizePath("lavora-con-noi", lang), label: footer.workWithUs[lang] },
  { href: localizePath("partner", lang), label: footer.partnerProgram[lang] },
  { href: localizePath("social-media-manager", lang), label: footer.smmOffer[lang] },
];
const offerLinks = CAMPAIGNS.map((c) => ({
  href: localizePath(`offerta/${c.slug}`, lang),
  label: tr(c.audience, lang),
}));
---

<footer class="site-footer">
  <div class="wrap-wide">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="big">ALPACODE</div>
        <div class="big-bar"></div>
        <div class="big big-sub">SOLUZIONI DIGITALI</div>
        <p>{tagline[lang]}</p>
      </div>

      <div class="foot-col">
        <h4>{footer.info[lang]}</h4>
        <ul>
          <li>{footer.base[lang]}</li>
          <li>{footer.vat[lang]}</li>
          <li>{footer.hours[lang]}</li>
        </ul>
      </div>

      <div class="foot-col">
        <h4>{footer.nav[lang]}</h4>
        <ul>
          {PAGES.map((p) => (
            <li>
              <a href={localizePath(p.slug, lang)}>{p.label[lang]}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="foot-col">
        <h4>{footer.contact[lang]}</h4>
        <ul>
          <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
          <li>
            {
              CAL_CONFIGURED ? (
                <a
                  href={prenotaHref}
                  data-cal-link={CAL_LINK}
                  data-cal-namespace={CAL_NAMESPACE}
                  data-cal-config={CAL_CONFIG}
                  data-journey="footer"
                >{footer.bookCall[lang]}</a>
              ) : (
                <a href={contattiHref}>{footer.bookCall[lang]}</a>
              )
            }
          </li>
          <li><a href={business.social.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
          <li><a href={business.social.github} rel="me noopener" target="_blank">GitHub</a></li>
        </ul>
        <h4 class="spaced">{footer.legal[lang]}</h4>
        <ul>
          <li><a href={privacyHref}>{footer.privacy[lang]}</a></li>
          <li><a href={cookieHref}>{footer.cookies[lang]}</a></li>
          <li><a href={terminiHref}>{footer.terms[lang]}</a></li>
          <li><button type="button" class="foot-link-btn" data-cookie-prefs>{cookiePrefsLabel}</button></li>
        </ul>
      </div>
    </div>

    <div class="foot-index">
      <div class="foot-index-row">
        <span class="foot-index-label">{footer.collab[lang]}</span>
        <nav aria-label={footer.collab[lang]}>
          {collabLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
      <div class="foot-index-row">
        <span class="foot-index-label">{footer.offers[lang]}</span>
        <nav aria-label={footer.offers[lang]}>
          {offerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    </div>

    <div class="foot-bottom">
      <span>{footer.rights[lang]}</span>
      <span>{footer.bottomLocation}</span>
      <span>{footer.version}</span>
    </div>
  </div>
</footer>
