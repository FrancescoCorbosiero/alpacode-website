---
import type { Lang } from "../i18n/types";
import { PAGES } from "../data/pages";
import { CAMPAIGNS, t as tr } from "../data/campaigns";
import { localizePath } from "../i18n/utils";
import { footer } from "../i18n/ui";
import { business, tagline } from "../data/business";
import { CAL_LINK, CAL_NAMESPACE, CAL_CONFIG, CAL_CONFIGURED } from "../lib/calcom";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const prenotaHref = localizePath("prenota", lang);
const contattiHref = localizePath("contatti", lang);
const privacyHref = localizePath("privacy", lang);
const cookieHref = localizePath("cookie", lang);
const terminiHref = localizePath("termini", lang);
const cookiePrefsLabel = lang === "it" ? "Preferenze cookie" : "Cookie preferences";

/* Secondary navigation — the program/marketing pages kept out of the
   primary nav on purpose. This strip is their internal-link home. */
const collabLinks = [
  { href: localizePath("lavora-con-noi", lang), label: footer.workWithUs[lang] },
  { href: localizePath("partner", lang), label: footer.partnerProgram[lang] },
  { href: localizePath("social-media-manager", lang), label: footer.smmOffer[lang] },
];
const offerLinks = CAMPAIGNS.map((c) => ({
  href: localizePath(`offerta/${c.slug}`, lang),
  label: tr(c.audience, lang),
}));
const commitmentLinks = [
  { href: localizePath("sostenibilita-ambientale", lang), label: footer.sustainability[lang] },
  {
    href: localizePath("sostenibilita-ambientale-report", lang),
    label: footer.sustainabilityReport[lang],
  },
  { href: localizePath("impatto-sociale-report", lang), label: footer.impactReport[lang] },
];
---

<footer class="site-footer">
  <div class="wrap-wide">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="big">ALPACODE</div>
        <div class="big-bar"></div>
        <div class="big big-sub">SOLUZIONI DIGITALI</div>
        <p>{tagline[lang]}</p>
      </div>

      <div class="foot-col">
        <h4>{footer.info[lang]}</h4>
        <ul>
          <li>{footer.base[lang]}</li>
          <li>{footer.vat[lang]}</li>
          <li>{footer.hours[lang]}</li>
        </ul>
      </div>

      <div class="foot-col">
        <h4>{footer.nav[lang]}</h4>
        <ul>
          {PAGES.map((p) => (
            <li>
              <a href={localizePath(p.slug, lang)}>{p.label[lang]}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="foot-col">
        <h4>{footer.contact[lang]}</h4>
        <ul>
          <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
          <li>
            {
              CAL_CONFIGURED ? (
                <a
                  href={prenotaHref}
                  data-cal-link={CAL_LINK}
                  data-cal-namespace={CAL_NAMESPACE}
                  data-cal-config={CAL_CONFIG}
                  data-journey="footer"
                >{footer.bookCall[lang]}</a>
              ) : (
                <a href={contattiHref}>{footer.bookCall[lang]}</a>
              )
            }
          </li>
          <li><a href={business.social.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
          <li><a href={business.social.github} rel="me noopener" target="_blank">GitHub</a></li>
        </ul>
        <h4 class="spaced">{footer.legal[lang]}</h4>
        <ul>
          <li><a href={privacyHref}>{footer.privacy[lang]}</a></li>
          <li><a href={cookieHref}>{footer.cookies[lang]}</a></li>
          <li><a href={terminiHref}>{footer.terms[lang]}</a></li>
          <li><button type="button" class="foot-link-btn" data-cookie-prefs>{cookiePrefsLabel}</button></li>
        </ul>
      </div>
    </div>

    <div class="foot-index">
      <div class="foot-index-row">
        <span class="foot-index-label">{footer.collab[lang]}</span>
        <nav aria-label={footer.collab[lang]}>
          {collabLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
      <div class="foot-index-row">
        <span class="foot-index-label">{footer.offers[lang]}</span>
        <nav aria-label={footer.offers[lang]}>
          {offerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
      <div class="foot-index-row">
        <span class="foot-index-label">{footer.commitment[lang]}</span>
        <nav aria-label={footer.commitment[lang]}>
          {commitmentLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    </div>

    <div class="foot-bottom">
      <span>{footer.rights[lang]}</span>
      <span>{footer.bottomLocation}</span>
      <span class="foot-clock" data-studio-root>
        <span data-studio-dot aria-hidden="true">●</span>
        <span data-studio-time>—:—</span> CET
      </span>
      <span>{footer.version}</span>
    </div>
  </div>
</footer>

<script>
  /* Studio clock — the small "someone is actually here" signal. Shows the
     current Monza time everywhere the footer is, and open/closed state
     where a label slot exists (contact page). Runs once (bundled module);
     re-syncs targets after every view-transition swap. */
  const timeFmt = new Intl.DateTimeFormat("it-IT", {
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "Europe/Rome",
  });
  const partsFmt = new Intl.DateTimeFormat("en-GB", {
    weekday: "short",
    hour: "numeric",
    hour12: false,
    timeZone: "Europe/Rome",
  });

  function studioOpen(now: Date): boolean {
    const parts = partsFmt.formatToParts(now);
    const wd = parts.find((p) => p.type === "weekday")?.value ?? "";
    const h = Number(parts.find((p) => p.type === "hour")?.value ?? "0");
    return !["Sat", "Sun"].includes(wd) && h >= 9 && h < 18;
  }

  function tick(): void {
    const now = new Date();
    const open = studioOpen(now);
    const time = timeFmt.format(now);
    document.querySelectorAll<HTMLElement>("[data-studio-time]").forEach((el) => {
      el.textContent = time;
    });
    document.querySelectorAll<HTMLElement>("[data-studio-root]").forEach((root) => {
      root.classList.toggle("is-open", open);
      const label = root.querySelector<HTMLElement>("[data-studio-label]");
      if (label) {
        const next = open ? root.dataset.openLabel : root.dataset.closedLabel;
        if (next) label.textContent = next;
      }
    });
  }

  let clockStarted = false;
  function start(): void {
    tick();
    if (clockStarted) return;
    clockStarted = true;
    window.setInterval(tick, 30_000);
  }

  document.addEventListener("astro:page-load", start);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
</script>
