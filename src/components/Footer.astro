---
import type { Lang } from "../i18n/types";
import { PAGES } from "../data/pages";
import { CAMPAIGNS, t as tr } from "../data/campaigns";
import { localizePath } from "../i18n/utils";
import { footer } from "../i18n/ui";
import { business, tagline } from "../data/business";
import BookCall from "./BookCall.astro";
import Alpaca from "./Alpaca.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const cookiePrefsLabel = lang === "it" ? "Preferenze cookie" : "Cookie preferences";

interface FootLink {
  href: string;
  label: string;
  external?: boolean;
}
interface FootGroup {
  title: string;
  links: FootLink[];
}

/* Three link columns of about the same height. The program/marketing pages
   have no primary-nav slot on purpose: these columns are their
   internal-link home. */
const columns: FootGroup[][] = [
  [
    {
      title: footer.nav[lang],
      links: PAGES.map((p) => ({ href: localizePath(p.slug, lang), label: p.label[lang] })),
    },
  ],
  [
    {
      title: footer.collab[lang],
      links: [
        { href: localizePath("collabora-con-noi", lang), label: footer.collaborate[lang] },
        { href: localizePath("partner", lang), label: footer.partnerProgram[lang] },
        { href: localizePath("voucher", lang), label: footer.referral[lang] },
        { href: localizePath("voucher/nuova-attivita", lang), label: footer.referralNew[lang] },
        { href: localizePath("social-media-manager", lang), label: footer.smmOffer[lang] },
        { href: localizePath("per-chi-fa-siti", lang), label: footer.builders[lang] },
      ],
    },
    {
      title: footer.commitment[lang],
      links: [
        { href: localizePath("sostenibilita-ambientale", lang), label: footer.sustainability[lang] },
        {
          href: localizePath("sostenibilita-ambientale-report", lang),
          label: footer.sustainabilityReport[lang],
        },
        { href: localizePath("impatto-sociale-report", lang), label: footer.impactReport[lang] },
      ],
    },
  ],
  [
    {
      title: footer.offers[lang],
      links: CAMPAIGNS.map((c) => ({
        href: localizePath(`offerta/${c.slug}`, lang),
        label: tr(c.audience, lang),
      })),
    },
    {
      title: footer.follow[lang],
      links: [
        { href: business.social.linkedin, label: "LinkedIn", external: true },
      ],
    },
  ],
];

const legalLinks: FootLink[] = [
  { href: localizePath("privacy", lang), label: footer.privacy[lang] },
  { href: localizePath("cookie", lang), label: footer.cookies[lang] },
  { href: localizePath("termini", lang), label: footer.terms[lang] },
];

/* The wordmark is set letter by letter so each letter can rise out of its
   own mask (motion.ts). Separate boxes can't kern, so Archivo Black's
   pairs for this word (GPOS: PA −85, AC −18 units) are applied by hand. */
const KERN: Record<string, string> = { PA: "-0.085em", AC: "-0.018em" };
const letters = [...business.wordmark].map((ch, i, all) => ({
  ch,
  kern: KERN[ch + (all[i + 1] ?? "")],
}));
---

<footer class="site-footer">
  <div class="wrap-wide">
    <div class="foot-main">
      <div class="foot-brand">
        <p class="foot-claim">{tagline[lang]}</p>
        <div class="foot-reach">
          <a class="foot-mail" href={`mailto:${business.email}`}>{business.email}</a>
          <BookCall label={footer.bookCall[lang]} journey="footer" lang={lang} class="btn-blue btn-sm" />
        </div>
        <ul class="foot-facts">
          <li>{footer.base[lang]}</li>
          <li>{footer.hours[lang]}</li>
          <li>{footer.vat[lang]}</li>
        </ul>
      </div>

      <nav class="foot-cols" aria-label={footer.sitemap[lang]}>
        {
          columns.map((groups) => (
            <div class="foot-col">
              {groups.map((g) => (
                <div class="foot-group">
                  <h2 class="foot-h">{g.title}</h2>
                  <ul>
                    {g.links.map((l) => (
                      <li>
                        {l.external ? (
                          <a href={l.href} rel="me noopener" target="_blank">{l.label}</a>
                        ) : (
                          <a href={l.href}>{l.label}</a>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))
        }
      </nav>
    </div>

    <div class="foot-bottom">
      <span>{footer.rights[lang]}</span>
      <ul class="foot-legal" aria-label={footer.legal[lang]}>
        {legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><button type="button" class="foot-link-btn" data-cookie-prefs>{cookiePrefsLabel}</button></li>
      </ul>
      <span class="foot-clock" data-studio-root>
        {footer.clock[lang]} <span data-studio-time>—:—</span>
      </span>
    </div>
  </div>
  {/* The signature: the wordmark spanning the grid, letters rising into
      view — and the alpaca of the name standing on its P (al-PACO-de),
      looking along the word. It rises from behind the P a beat after the
      letters. */}
  <div class="foot-wordmark-wrap" aria-hidden="true">
    <div class="foot-wordmark">
      {letters.map(({ ch, kern }) => (
        <span class="foot-mask" style={kern ? `--kern:${kern}` : undefined}><span class="foot-char">{ch}</span></span>
      ))}
      <span class="foot-alpaca-spot"><Alpaca class="foot-alpaca" width={52} data-alpaca /></span>
    </div>
  </div>
</footer>

<script>
  /* Studio clock — the small "someone is actually here" signal. Shows the
     current Monza time everywhere the footer is, and open/closed state
     where a label slot exists (contact page). Runs once (bundled module);
     re-syncs targets after every view-transition swap. */
  const timeFmt = new Intl.DateTimeFormat("it-IT", {
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "Europe/Rome",
  });
  const partsFmt = new Intl.DateTimeFormat("en-GB", {
    weekday: "short",
    hour: "numeric",
    hour12: false,
    timeZone: "Europe/Rome",
  });

  function studioOpen(now: Date): boolean {
    const parts = partsFmt.formatToParts(now);
    const wd = parts.find((p) => p.type === "weekday")?.value ?? "";
    const h = Number(parts.find((p) => p.type === "hour")?.value ?? "0");
    return !["Sat", "Sun"].includes(wd) && h >= 9 && h < 18;
  }

  function tick(): void {
    const now = new Date();
    const open = studioOpen(now);
    const time = timeFmt.format(now);
    document.querySelectorAll<HTMLElement>("[data-studio-time]").forEach((el) => {
      el.textContent = time;
    });
    document.querySelectorAll<HTMLElement>("[data-studio-root]").forEach((root) => {
      root.classList.toggle("is-open", open);
      const label = root.querySelector<HTMLElement>("[data-studio-label]");
      if (label) {
        const next = open ? root.dataset.openLabel : root.dataset.closedLabel;
        if (next) label.textContent = next;
      }
    });
  }

  let clockStarted = false;
  function start(): void {
    tick();
    if (clockStarted) return;
    clockStarted = true;
    window.setInterval(tick, 30_000);
  }

  document.addEventListener("astro:page-load", start);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
</script>
