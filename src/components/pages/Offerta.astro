---
import type { Lang } from "../../i18n/types";
import type { ImageMetadata } from "astro";
import type { Campaign } from "../../data/campaigns";
import {
  STATS,
  AI,
  AI_IMAGE,
  STEPS,
  GUARANTEES,
  FAQ,
  COPY,
  offerVariants,
  t,
} from "../../data/campaigns";
import { localizePath } from "../../i18n/utils";
import RemoteImage from "../RemoteImage.astro";
import Countdown from "../islands/Countdown.tsx";
import CampaignForm from "../islands/CampaignForm.tsx";
import type { CampaignFormLabels } from "../islands/CampaignForm";

interface Props {
  lang: Lang;
  campaign: Campaign;
}
const { lang, campaign: c } = Astro.props;

const variants = offerVariants(c.price);
const privacyHref = localizePath("privacy", lang);

// Drop a file named <slug>.<ext> (or ai.<ext>) into src/assets/campaigns/ and
// it's picked up, optimized, automatically — overriding the Unsplash hotlink.
const campaignImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/campaigns/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);
const localImg = (id: string): ImageMetadata | undefined =>
  Object.entries(campaignImages).find(
    ([p]) => p.split("/").pop()?.replace(/\.[^.]+$/, "") === id,
  )?.[1].default;

const heroLocal = localImg(c.heroImage.id);
const aiLocal = localImg(AI_IMAGE.id);

const cd = COPY.countdown;
const countdownLabels = {
  days: t(cd.days, lang),
  hours: t(cd.hours, lang),
  minutes: t(cd.minutes, lang),
  seconds: t(cd.seconds, lang),
};

const formLabels: CampaignFormLabels = {
  name: lang === "it" ? "Nome e cognome" : "Full name",
  namePlaceholder: lang === "it" ? "Mario Rossi" : "Jane Doe",
  email: "Email",
  emailPlaceholder: lang === "it" ? "nome@dominio.it" : "name@domain.com",
  phone: lang === "it" ? "Telefono (opzionale)" : "Phone (optional)",
  phonePlaceholder: "+39 …",
  business: lang === "it" ? "Attività (opzionale)" : "Business (optional)",
  businessPlaceholder: lang === "it" ? "Es. Studio Rossi" : "e.g. Doe Studio",
  message: lang === "it" ? "Due righe su di te (opzionale)" : "A couple of lines about you (optional)",
  messagePlaceholder:
    lang === "it" ? "Cosa fai, cosa ti serve." : "What you do, what you need.",
  chosenOffer: t(COPY.chosenOffer, lang),
  send: t(COPY.ctaPrimary, lang),
  consent:
    lang === "it"
      ? "Ho letto la privacy policy e acconsento al trattamento dei dati per essere ricontattato/a."
      : "I have read the privacy policy and consent to data processing to be contacted back.",
  confirm: lang === "it" ? "GRAZIE — TI RICONTATTIAMO PRESTISSIMO" : "THANKS — WE'LL REACH OUT VERY SOON",
  error: lang === "it" ? "QUALCOSA È ANDATO STORTO — RIPROVA" : "SOMETHING WENT WRONG — RETRY",
  variants: {
    "all-inclusive": t(variants[0].tab, lang),
    "premium-extras": t(variants[1].tab, lang),
  },
};
---

<!-- HERO -->
<section class="cmp-hero">
  <div class="wrap-wide">
    <div class="cmp-hero-grid">
      <div class="cmp-hero-col">
        <div class="cmp-eyebrow">{t(c.eyebrow, lang)} · {t(c.audience, lang)}</div>
        <h1 class="cmp-h1">
          <span class="bar" aria-hidden="true"></span>
          {t(c.hero.line1, lang)}<br />{t(c.hero.line2, lang)}
        </h1>
        <p class="cmp-lede">{t(c.hero.lede, lang)}</p>

        <div class="cmp-scarcity">
          <div class="cmp-scar-block">
            <span class="cmp-scar-k">{t(COPY.deadlineLabel, lang)}</span>
            <Countdown
              client:load
              deadlineISO={c.deadlineISO}
              labels={countdownLabels}
              closedLabel={t(COPY.closed, lang)}
            />
          </div>
          <div class="cmp-scar-block cmp-seats">
            <span class="cmp-scar-k">{t(COPY.seatsLabel, lang)}</span>
            <span class="cmp-seats-v">
              <strong>{c.seatsLeft}</strong> {t(COPY.ofLabel, lang)} {c.seats}
            </span>
          </div>
        </div>

        <div class="cmp-hero-cta">
          <a class="btn btn-blue" href="#offerta">{t(COPY.ctaPrimary, lang)} <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href="#offer-detail">{t(COPY.ctaSecondary, lang)}</a>
        </div>
      </div>

      <div class="cmp-hero-media">
        <RemoteImage
          local={heroLocal}
          src={c.heroImage.src}
          alt={t(c.heroImage.alt, lang)}
          placeholder={t(c.audience, lang)}
          loading="eager"
          ratio="4 / 5"
        />
      </div>
    </div>
  </div>
</section>

<!-- PAINS -->
<section class="cmp-section">
  <div class="wrap-wide">
    <div class="cmp-pains">
      {
        c.pains.map((p) => (
          <div class="cmp-pain">
            <span class="strut-short" aria-hidden="true"></span>
            <h3>{t(p.k, lang)}</h3>
            <p>{t(p.v, lang)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- STATS — Italia indietro -->
<section class="cmp-section cmp-stats-sec">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num eyebrow" style="color:var(--blue)">{t(COPY.statsKicker, lang)}</div>
        <h2>{t(COPY.statsTitle, lang)}</h2>
      </div>
      <p class="lede">{t(COPY.statsLede, lang)}</p>
    </div>
    <div class="cmp-stats">
      {
        STATS.map((s) => (
          <div class="cmp-stat">
            <div class="cmp-stat-v">{s.value}</div>
            <div class="cmp-stat-l">{t(s.label, lang)}</div>
            <div class="cmp-stat-src">{s.source}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- AI — why quality no longer costs thousands -->
<section class="cmp-section cmp-ai">
  <div class="wrap-wide">
    <div class="cmp-ai-grid">
      <div class="cmp-ai-lead">
        <div class="sec-num eyebrow" style="color:var(--blue)">{t(AI.kicker, lang)}</div>
        <h2>{t(AI.title, lang)}</h2>
        <p class="lede">{t(AI.lede, lang)}</p>
      </div>
      <div class="cmp-ai-points">
        <RemoteImage
          local={aiLocal}
          src={AI_IMAGE.src}
          alt={t(AI_IMAGE.alt, lang)}
          placeholder="AI · ALPACODE"
          class="cmp-ai-img"
          ratio="16 / 9"
        />
        {
          AI.points.map((p) => (
            <div class="cmp-ai-point">
              <span class="strut-short" aria-hidden="true"></span>
              <h3>{t(p.k, lang)}</h3>
              <p>{t(p.v, lang)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- OFFER — toggle between the two strategies -->
<section class="cmp-section cmp-offer" id="offer-detail">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num eyebrow" style="color:var(--blue)">{t(COPY.offerKicker, lang)}</div>
        <h2>{t(COPY.offerTitle, lang)}</h2>
      </div>
    </div>

    <div class="cmp-toggle" role="tablist" aria-label={t(COPY.offerTitle, lang)}>
      {
        variants.map((v, i) => (
          <button
            class={"cmp-tab " + (i === 0 ? "is-active" : "")}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            data-variant={v.id}
            type="button"
          >
            {t(v.tab, lang)}
          </button>
        ))
      }
    </div>

    <div class="cmp-panels">
      {
        variants.map((v, i) => (
          <div
            class={"cmp-panel " + (i === 0 ? "is-active" : "")}
            data-panel={v.id}
            role="tabpanel"
            hidden={i !== 0}
          >
            <div class="cmp-panel-grid">
              <div class="cmp-panel-head">
                <h3>{t(v.headline, lang)}</h3>
                <p>{t(v.blurb, lang)}</p>
                <div class="cmp-price">
                  <span class="cmp-price-v">{c.price} €</span>
                  <span class="cmp-price-per">{lang === "it" ? "/anno" : "/year"}</span>
                </div>
                <div class="cmp-price-note">{t(v.priceNote, lang)}</div>
                <a class="btn btn-blue" href="#offerta">{t(COPY.ctaPrimary, lang)} <span class="arrow">→</span></a>
              </div>
              <div class="cmp-includes">
                <div class="cmp-includes-k">{t(COPY.includesLabel, lang)}</div>
                <ul>
                  {v.includes.map((it) => (
                    <li>{t(it, lang)}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- STEPS -->
<section class="cmp-section">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num eyebrow" style="color:var(--blue)">{t(COPY.stepsKicker, lang)}</div>
        <h2>{t(COPY.stepsTitle, lang)}</h2>
      </div>
    </div>
    <div class="cmp-steps">
      {
        STEPS.map((s) => (
          <div class="cmp-step">
            <div class="cmp-step-n">{s.n}</div>
            <h3>{t(s.t, lang)}</h3>
            <p>{t(s.d, lang)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- GUARANTEES -->
<section class="cmp-section cmp-guarantees">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num eyebrow" style="color:var(--blue)">{t(COPY.guaranteesKicker, lang)}</div>
        <h2>{t(COPY.guaranteesTitle, lang)}</h2>
      </div>
    </div>
    <div class="cmp-guar-grid">
      {
        GUARANTEES.map((g) => (
          <div class="cmp-guar">
            <span class="strut-short" aria-hidden="true"></span>
            <h3>{t(g.t, lang)}</h3>
            <p>{t(g.d, lang)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="cmp-section">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num eyebrow" style="color:var(--blue)">{t(COPY.faqKicker, lang)}</div>
        <h2>{t(COPY.faqTitle, lang)}</h2>
      </div>
    </div>
    <div class="cmp-faq">
      {
        FAQ.map((f, i) => (
          <details class="cmp-faq-item" open={i === 0}>
            <summary>{t(f.q, lang)}</summary>
            <p>{t(f.a, lang)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- FORM -->
<section class="cmp-section cmp-form-sec" id="offerta">
  <div class="wrap-wide">
    <div class="cmp-form-grid">
      <div class="cmp-form-intro">
        <div class="sec-num eyebrow" style="color:var(--blue)">{t(COPY.formKicker, lang)}</div>
        <h2>{t(COPY.formTitle, lang)}</h2>
        <p class="lede">{t(COPY.formLede, lang)}</p>
        <div class="cmp-form-scar">
          <span class="cmp-scar-k">{t(COPY.seatsLabel, lang)}</span>
          <span class="cmp-seats-v"><strong>{c.seatsLeft}</strong> {t(COPY.ofLabel, lang)} {c.seats}</span>
        </div>
        <p class="cmp-form-privacy">
          <a href={privacyHref}>{lang === "it" ? "Come trattiamo i tuoi dati →" : "How we handle your data →"}</a>
        </p>
      </div>
      <div class="cmp-form-box">
        <CampaignForm
          client:idle
          lang={lang}
          campaign={c.slug}
          audience={t(c.audience, lang)}
          price={c.price}
          labels={formLabels}
        />
      </div>
    </div>
  </div>
</section>

<script>
  // Offer toggle: switch active tab + panel, and tell the lead form which
  // variant is selected so its "chosen offer" line stays in sync.
  function initOfferToggle() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".cmp-tab"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>(".cmp-panel"));
    if (!tabs.length) return;
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.variant;
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle("is-active", on);
          t.setAttribute("aria-selected", on ? "true" : "false");
        });
        panels.forEach((p) => {
          const on = p.dataset.panel === id;
          p.classList.toggle("is-active", on);
          p.hidden = !on;
        });
        if (id) window.dispatchEvent(new CustomEvent("offer-variant", { detail: id }));
      });
    });
  }
  document.addEventListener("astro:page-load", initOfferToggle);
</script>
