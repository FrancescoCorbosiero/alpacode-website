---
import type { Lang } from "../../i18n/types";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { contatti } from "../../data/contatti";
import { wizard } from "../../data/wizard";
import { business } from "../../data/business";
import { localizePath } from "../../i18n/utils";
import PageHero from "../PageHero.astro";
import ContactForm from "../islands/ContactForm.tsx";
import BriefWizard from "../islands/BriefWizard.tsx";
import Coverage from "../home/Coverage.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = contatti[lang];
const w = wizard[lang];
const prenotaHref = localizePath("prenota", lang);

// Founder photo slot — drop src/assets/people/francesco.<ext> and the
// initials placeholder disappears (see src/assets/README.md).
const peopleImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/people/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);
const founderImg = Object.entries(peopleImages).find(
  ([p]) => p.split("/").pop()?.replace(/\.[^.]+$/, "") === "francesco",
)?.[1].default;
---

<PageHero crumb={t.crumb} line1={t.h1Line1} line2={t.h1Line2} lede={t.lede} />

{/* ---------- 60-second wizard + the human block ---------- */}
<section class="section" id="wizard" style="border-top:1px solid var(--rule)">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num eyebrow">{w.kicker}</div>
        <h2>{w.title}</h2>
      </div>
      <p class="lede">{w.lede}</p>
    </div>
    <div class="bw-grid">
      <BriefWizard client:load lang={lang} labels={w} prenotaHref={prenotaHref} />
      <aside class="contact-info bw-person">
        <h3>{t.person.h}</h3>
        <div class="bw-founder">
          {
            founderImg ? (
              <Image
                src={founderImg}
                alt={t.person.sig.photoAlt}
                widths={[96, 192]}
                sizes="96px"
                class="bw-founder-img"
              />
            ) : (
              <span class="bw-founder-ph" aria-hidden="true">{t.person.sig.initials}</span>
            )
          }
          <span class="bw-founder-id">
            <span class="bw-founder-name">{t.person.sig.name}</span>
            <span class="bw-founder-role">{t.person.sig.role}</span>
          </span>
        </div>
        {
          t.person.points.map((p) => (
            <div class="block">
              <span class="k">— {p.k}</span>
              <span class="v">{p.v}</span>
            </div>
          ))
        }
        <div
          class="bw-clock"
          data-studio-root
          data-open-label={t.person.clockOpen}
          data-closed-label={t.person.clockClosed}
        >
          <span class="bw-clock-dot" data-studio-dot aria-hidden="true">●</span>
          <span data-studio-label>{t.person.clockOpen}</span>
          <span class="bw-clock-time"><span data-studio-time>—:—</span> CET</span>
        </div>
      </aside>
    </div>
  </div>
</section>

<section style="border-top:1px solid var(--rule)">
  <div class="wrap-wide">
    <div class="contact-grid">
      <ContactForm client:idle lang={lang} labels={t.labels} />

      <aside class="contact-info">
        <h3>{t.info.h}</h3>
        <div class="block">
          <span class="k">— {t.info.email}</span>
          <a href={`mailto:${business.email}`} class="v">{t.info.emailV}</a>
        </div>
        <div class="block">
          <span class="k">— {t.info.base}</span>
          <span class="v">{t.info.baseV}</span>
        </div>
        <div class="block">
          <span class="k">— {t.info.vat}</span>
          <span class="v">{t.info.vatV}</span>
        </div>
        <div class="block">
          <span class="k">— {t.info.hours}</span>
          <span class="v">{t.info.hoursV}</span>
        </div>
        <div class="block">
          <span class="k">— {t.info.reply}</span>
          <span class="v">{t.info.replyV}</span>
        </div>
        <div class="contact-available">
          <div class="eyebrow">● {t.info.availableLabel}</div>
          <div class="v">{t.info.availableV}</div>
        </div>
      </aside>
    </div>
  </div>
</section>

<Coverage lang={lang} bare />
