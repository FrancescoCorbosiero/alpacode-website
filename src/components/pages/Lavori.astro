---
/* /lavori — the showcase. One row per project: its number, its name in
   the display face, sector, place and year, a small frame of its site.
   The filters (radio chips) sort by kind of work with CSS alone
   (:has), and the flip-filter effect animates the change; with a mouse
   the cursor-thumb effect floats a large frame of the row's site next
   to the pointer. A row opens its case page, and its frame (the small
   one, or the floating one) becomes the case page's frame on the way
   (a view transition named after the project). */
import type { Lang } from "../../i18n/types";
import { KIND_LABELS, WORK_KINDS, factsOf, hostOf, no, shotFor, workHref, workLabels, works } from "../../data/work";
import PageHero from "../PageHero.astro";
import BrowserFrame from "../BrowserFrame.astro";
import Coverage from "../home/Coverage.astro";
import CtaFinal from "../home/CtaFinal.astro";
import Statement from "../Statement.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = workLabels[lang];
const list = await works();

const kinds = WORK_KINDS.filter((k) => list.some((w) => w.data.kind === k));
const chips = [
  { value: "all", label: L.all, n: list.length },
  ...kinds.map((k) => ({ value: k, label: KIND_LABELS[k][lang], n: list.filter((w) => w.data.kind === k).length })),
];
/* Filtering without a script: the checked chip hides the other kinds.
   The flip-filter effect sets data-flip-filter-on and takes over. */
const filterCss = kinds
  .map((k) => `.works:not([data-flip-filter-on]):has(input[value="${k}"]:checked) .works-row:not([data-kind="${k}"]){display:none}`)
  .join("");

const t =
  lang === "it"
    ? {
        crumb: "Lavori",
        line1: "I nostri",
        line2: "lavori.",
        lede: "Progetti reali in settori molto diversi — edilizia, streetwear, editoria, fitness, pesca, logistica — ognuno con la sua strategia di comunicazione su misura.",
        statement:
          "Ogni progetto parte da un problema vero — farsi trovare, farsi scegliere, vendere online — e si misura con numeri veri, non con promesse.",
      }
    : {
        crumb: "Work",
        line1: "Our",
        line2: "work.",
        lede: "Real projects across very different sectors — construction, streetwear, publishing, fitness, fishing, logistics — each with its own tailored communication strategy.",
        statement:
          "Every project starts from a real problem — being found, being chosen, selling online — and is measured with real numbers, not promises.",
      };
---

<PageHero crumb={t.crumb} line1={t.line1} line2={t.line2} lede={t.lede} />

<section class="works" data-flip-filter>
  <style is:inline set:html={filterCss}></style>
  <div class="wrap-wide">
    <fieldset class="works-filter">
      <legend class="visually-hidden">{L.filterBy}</legend>
      {
        chips.map((c) => (
          <label class="works-chip">
            <input type="radio" name="work-kind" value={c.value} checked={c.value === "all"} />
            <span class="works-chip-label">{c.label}</span>
            <span class="works-chip-n">{c.n}</span>
          </label>
        ))
      }
    </fieldset>

    <ol class="works-list" data-cursor-thumb>
      {
        list.map((w, i) => {
          const title = w.data.title[lang];
          return (
            <li
              class="works-row"
              data-kind={w.data.kind}
              data-flip-filter-item={w.data.kind}
              data-cursor-thumb-row
              data-cursor-thumb-label={hostOf(w.data.url) ?? title}
              data-cursor-thumb-vt={`work-${w.id}`}
            >
              <a class="works-link" href={workHref(w.id, lang)}>
                <span class="works-no">{no(i)}</span>
                <span class="works-name" style={`view-transition-name:work-title-${w.id}`}>
                  {title}
                </span>
                <span class="works-meta">
                  {factsOf(w.data, lang).map((f) => (
                    <span>{f}</span>
                  ))}
                </span>
                <span class="works-desc">
                  {w.data.descriptor[lang]}
                </span>
                <span class="works-thumb" data-cursor-thumb-pic>
                  <BrowserFrame
                    shot={shotFor(w.id)}
                    alt=""
                    bar={hostOf(w.data.url) ?? title}
                    sizes="(max-width: 700px) 100vw, (max-width: 1024px) 50vw, 160px"
                    name={`work-${w.id}`}
                  />
                </span>
                <span class="works-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>

    {/* The floating frame of the hover preview: empty and hidden until the
        effect fills it with the rows' screenshots (a mouse only). */}
    <div class="works-preview" data-cursor-thumb-frame hidden aria-hidden="true">
      <div class="bframe">
        <div class="bframe-bar">
          <span class="bframe-dots"><i></i><i></i><i></i></span>
          <span class="bframe-addr" data-cursor-thumb-bar></span>
        </div>
        <div class="bframe-view" data-cursor-thumb-slot></div>
      </div>
    </div>
  </div>
</section>

<Statement text={t.statement} />

<Coverage lang={lang} bare />
<CtaFinal lang={lang} />
