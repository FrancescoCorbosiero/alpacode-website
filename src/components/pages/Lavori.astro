---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import type { Lang } from "../../i18n/types";
import PageHero from "../PageHero.astro";
import ImageSlot from "../ImageSlot.astro";
import CtaFinal from "../home/CtaFinal.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const works = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);

// Drop a file named <entry-id>.<ext> into src/assets/work/ (e.g.
// studio-legale.jpg) and it's picked up here, optimized, automatically.
const workImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/work/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const imgFor = (id: string): ImageMetadata | undefined =>
  Object.entries(workImages).find(([p]) => p.split("/").pop()?.replace(/\.[^.]+$/, "") === id)?.[1]
    .default;

const t =
  lang === "it"
    ? {
        crumb: "§04 · LAVORI",
        line1: "Sei progetti",
        line2: "raccontati bene.",
        lede: "Un campione di quello che abbiamo costruito di recente.",
        placeholder: "Foto del progetto",
      }
    : {
        crumb: "§04 · WORK",
        line1: "Six projects,",
        line2: "told well.",
        lede: "A sample of what we've built recently.",
        placeholder: "Project photo",
      };
---

<PageHero crumb={t.crumb} line1={t.line1} line2={t.line2} lede={t.lede} />

<section class="section" style="padding-top:56px">
  <div class="wrap-wide">
    <div class="work-grid">
      {
        works.map((w, i) => (
          <article class="work">
            <ImageSlot placeholder={t.placeholder} src={imgFor(w.id)} alt={w.data.title[lang]} />
            <div class="meta">
              <span>— {String(i + 1).padStart(2, "0")}</span>
              <span>{w.data.year} · {w.data.sector[lang]}</span>
            </div>
            <h3>{w.data.title[lang]}</h3>
            <p>{w.data.descriptor[lang]}</p>
            <div class="tags">
              {w.data.tags.map((tg) => (
                <span class="tag">{tg}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<CtaFinal lang={lang} />
