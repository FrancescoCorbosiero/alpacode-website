---
import type { Lang } from "../../i18n/types";
import { legal, type LegalKind } from "../../data/legal";
import { localizePath } from "../../i18n/utils";
import PageHero from "../PageHero.astro";

interface Props {
  lang: Lang;
  kind: LegalKind;
}
const { lang, kind } = Astro.props;
const t = legal[kind][lang];
const homeHref = localizePath("", lang);
const backLabel = lang === "it" ? "Torna alla home" : "Back to home";
---

<PageHero crumb={t.crumb} line1={t.h1Line1} line2={t.h1Line2} lede={t.lede} />

<section class="article legal">
  <div class="wrap">
    <div class="prose">
      {
        t.sections.map((s) => (
          <Fragment>
            <h2>{s.h}</h2>
            <Fragment set:html={s.body} />
          </Fragment>
        ))
      }
      <p class="legal-updated">{t.updated}</p>
      <a class="article-back" href={homeHref}>← {backLabel}</a>
    </div>
  </div>
</section>
