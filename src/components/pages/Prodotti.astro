---
import type { Lang } from "../../i18n/types";
import { prodotti } from "../../data/products";
import { localizePath } from "../../i18n/utils";
import PageHero from "../PageHero.astro";
import Values from "../home/Values.astro";
import CtaFinal from "../home/CtaFinal.astro";
import BookCall from "../BookCall.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = prodotti[lang];
const start = lang === "it" ? "Inizia da qui" : "Start here";
const learnMore = lang === "it" ? "Scopri di più" : "Learn more";
---

<PageHero crumb={t.crumb} line1={t.h1Line1} line2={t.h1Line2} lede={t.lede} />

<section class="section" style="padding-top:32px">
  <div class="wrap-wide">
    <div class="eyebrow" style="margin-bottom:32px">● {t.intro}</div>

    {
      t.groups.map((g) => (
        <div class="product-group">
          <div class="svc-group-head">
            <h2 class="svc-group-verb">{g.label}</h2>
            <p class="svc-group-tag">{g.tagline}</p>
          </div>
          <div class:list={["product-grid", { "product-grid--featured": g.featured }]}>
            {g.list.map((p) => (
              <article class:list={["product", { "product--featured": g.featured }]}>
                <div class="product-top">
                  <span class="product-no">{p.n}</span>
                  <span class="product-tag">{p.tag}</span>
                </div>
                <h3>{p.t}</h3>
                <p class="product-for">{p.forWho}</p>
                <p class="product-desc">{p.d}</p>
                <ul class="product-items">
                  {p.items.map((i) => (
                    <li><span>{i}</span></li>
                  ))}
                </ul>
                <div class="product-meta">
                  {p.meta.map((m) => (
                    <div>
                      <span class="k">{m.k}</span>
                      <span class="v">{m.v}</span>
                    </div>
                  ))}
                </div>
                {p.slug ? (
                  <a class="btn btn-sm" href={localizePath(p.slug, lang)} data-journey="product-learn-more">
                    {learnMore} <span class="arrow">→</span>
                  </a>
                ) : (
                  <BookCall label={start} journey="product" lang={lang} class="btn-sm" />
                )}
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<Values lang={lang} bare />
<CtaFinal lang={lang} />
