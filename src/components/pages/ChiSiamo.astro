---
/* /chi-siamo — the studio and its people (data/chi-siamo.ts): the
   studio's plate (its facts, on a pane of glass); the people on equal
   footing: three panes that meet where your project is (the team
   scene, effects/team.ts), then a plate each (a window with a photo
   from src/assets/people/<id>.<ext> when there is one, the initials
   traced on the glass until then: the pane effect); what we do, each
   thing leading to its service page; who we work best with; the
   network; the doors. */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { Lang } from "../../i18n/types";
import { chiSiamo } from "../../data/chi-siamo";
import { serviceHref } from "../../data/service-pages";
import { localizePath } from "../../i18n/utils";
import { business } from "@shared/data/business";
import { COMPARTMENTS, DOORS, doorTo } from "@shared/data/compartments";
import PageHero from "../PageHero.astro";
import Statement from "../Statement.astro";
import CtaFinal from "../home/CtaFinal.astro";
import Br from "../Br.astro";
import Alpaca from "../Alpaca.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = chiSiamo[lang];

const photos = import.meta.glob<{ default: ImageMetadata }>("../../assets/people/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}", {
  eager: true,
});
const photoFor = (id: string) =>
  Object.entries(photos).find(([p]) => p.split("/").pop()?.replace(/\.[^.]+$/, "") === id)?.[1].default;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
const first = (name: string) => name.split(/\s+/)[0];
const no = (i: number) => String(i + 1).padStart(2, "0");
const PANES = ["a", "b", "c"] as const;
---

<PageHero crumb={t.crumb} line1={t.h1Line1} line2={t.h1Line2} lede={t.lede} />

{/* ---------- The studio's plate ---------- */}
<section class="section about-plate-sec">
  <div class="wrap-wide">
    <div class="about-plate" data-pane>
      <span class="pane-glint" data-pane-glint aria-hidden="true"></span>
      <div class="about-plate-head">
        <p class="about-plate-name">{business.name}</p>
        <Alpaca class="about-plate-alpaca" />
      </div>
      <dl class="about-plate-facts">
        {
          t.plate.facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
      <p class="about-plate-vat">{t.plate.vat} {business.vat}</p>
    </div>
  </div>
</section>

{/* ---------- The people: three panes, then a plate each ---------- */}
<section class="section about-people">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num">{t.people.kicker}</div>
        <h2><Br text={t.people.title} /></h2>
      </div>
    </div>

    <div class="about-team-grid">
      <div class="about-team" data-scene="team" aria-hidden="true">
        <div class="about-team-stage">
          {
            t.people.list.slice(0, 3).map((p, i) => (
              <div class={`about-pane about-pane--${PANES[i]}`} data-team-pane>
                <span class="about-pane-no">{no(i)}</span>
                <span class="about-pane-name">{first(p.name)}</span>
                <span class="about-pane-what">{p.what}</span>
              </div>
            ))
          }
          <div class="about-team-core" data-team-core>
            <span>{t.people.core}</span>
          </div>
        </div>
      </div>
      <div class="about-team-copy">
        <p class="about-team-lede" data-reveal>{t.people.lede}</p>
        <p class="about-team-note" data-reveal>{t.people.coreNote}</p>
      </div>
    </div>

    <ol class="about-people-list">
      {
        t.people.list.map((p, i) => {
          const photo = photoFor(p.id);
          return (
            <li class="about-person" data-reveal>
              <figure class="about-window" data-pane>
                {photo ? (
                  <Image src={photo} alt={p.name} widths={[360, 720]} sizes="(max-width: 900px) 100vw, 30vw" />
                ) : (
                  <svg class="about-initials" viewBox="0 0 400 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                    <text x="200" y="262" text-anchor="middle" data-pane-trace>
                      {initials(p.name)}
                    </text>
                  </svg>
                )}
                <span class="pane-glint" data-pane-glint aria-hidden="true" />
              </figure>
              <p class="about-role">
                <span class="about-no">{no(i)}</span>
                {p.role}
              </p>
              <h3 class="about-name">{p.name}</h3>
              <div class="about-bio">
                {p.bio.map((b) => (
                  <p>{b}</p>
                ))}
              </div>
              <ul class="about-tags">
                {p.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              {p.linkedin && (
                <a class="about-link" href={p.linkedin} target="_blank" rel="me noopener">
                  LinkedIn ↗
                </a>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

{/* ---------- What we do: each thing, its page ---------- */}
<section class="section section--tint about-what">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num">{t.what.kicker}</div>
        <h2><Br text={t.what.title} /></h2>
      </div>
    </div>
    <ol class="about-what-list">
      {
        t.what.items.map((it, i) => (
          <li class="about-what-item" data-reveal>
            <a href={serviceHref(it.slug, lang)}>
              <span class="about-what-n">{no(i)}</span>
              <h3>{it.t}</h3>
              <p>{it.d}</p>
              <span class="about-what-go">
                {t.what.go} <span class="arrow" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<Statement text={t.statement} />

<section class="section about-fit">
  <div class="wrap-wide about-fit-grid">
    <div>
      <div class="sec-num">{t.fit.kicker}</div>
      <h2 class="about-fit-title"><Br text={t.fit.title} /></h2>
    </div>
    <ul class="about-fit-list">
      {
        t.fit.items.map((it) => (
          <li data-reveal>
            <span class="about-fit-mark" aria-hidden="true" />
            {it}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section section--tint about-network">
  <div class="wrap-wide about-network-grid">
    <a class="about-door" href={localizePath("collabora-con-noi", lang)} data-reveal>
      <h2>{t.network.title}</h2>
      <p>{t.network.text}</p>
      <span class="about-door-go">{t.network.cta} →</span>
    </a>
    {
      DOORS.map((id) => (
        <a class="about-door about-door--compartment" href={doorTo(id, "/", { site: "house", where: "chi-siamo" })} data-reveal>
          <h2>{COMPARTMENTS[id].name}</h2>
          <p>{COMPARTMENTS[id].line[lang]}</p>
          <span class="about-door-go">{COMPARTMENTS[id].origin.replace(/^https?:\/\//, "")} ↗</span>
        </a>
      ))
    }
  </div>
</section>

<CtaFinal lang={lang} />
