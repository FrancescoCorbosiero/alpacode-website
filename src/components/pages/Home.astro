---
import type { ImageMetadata } from "astro";
import type { Lang } from "../../i18n/types";
import { cases } from "../../data/home";
import { localizePath } from "../../i18n/utils";
import Hero from "../home/Hero.astro";
import Pitch from "../home/Pitch.astro";
import Verbs from "../home/Verbs.astro";
import Values from "../home/Values.astro";
import Scale from "../home/Scale.astro";
import ProductsTeaser from "../home/ProductsTeaser.astro";
import Process from "../home/Process.astro";
import Ai from "../home/Ai.astro";
import Manifesto from "../home/Manifesto.astro";
import Coverage from "../home/Coverage.astro";
import CtaFinal from "../home/CtaFinal.astro";
import Ticker from "../Ticker.astro";
import Cases from "../islands/Cases.tsx";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = cases[lang];

// Case photos resolve from src/assets/work/<key>.<ext> — the same files the
// Lavori grid uses (edilcalmi, resellpiacenza, cesana). Otherwise the
// placeholder stays. Keyed, so one file works for both IT and EN.
const caseImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/work/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);
const caseImgFor = (key: string): string | undefined =>
  Object.entries(caseImages).find(([p]) => p.split("/").pop()?.replace(/\.[^.]+$/, "") === key)
    ?.[1].default.src;
const caseList = c.list.map((cs) => ({ ...cs, img: caseImgFor(cs.key) }));

const caseLabels = {
  problem: lang === "it" ? "Il problema" : "The problem",
  before: lang === "it" ? "Prima" : "Before",
  after: lang === "it" ? "Dopo" : "After",
  placeholder: lang === "it" ? "La foto del progetto" : "Project photo",
};
const tickerItems =
  lang === "it"
    ? ["Siti & e-commerce", "Branding", "Pubblicità", "Software & AI", "Formazione", "Digitalizzazione", "Privati & imprese", "Monza · Milano"]
    : ["Websites & e-commerce", "Branding", "Advertising", "Software & AI", "Training", "Digitalization", "People & businesses", "Monza · Milan"];

const lavoriHref = localizePath("lavori", lang);
const casesCta = lang === "it" ? "Vedi tutti i lavori" : "See all the work";
---

<Hero lang={lang} />
<Ticker items={tickerItems} />
<Pitch lang={lang} />
<Verbs lang={lang} />
<Values lang={lang} />
<Scale lang={lang} />

<section class="section section--tint cases-band" style="padding-top:56px">
  <div class="wrap-wide">
    <div class="section-head">
      <div>
        <div class="sec-num">{c.num}</div>
        <h2 style="white-space:pre-line">{c.heading}</h2>
      </div>
      <p class="lede">{c.lede}</p>
    </div>
    <Cases client:visible cases={caseList} labels={caseLabels} />
    <div class="band-cta">
      <a class="btn btn-ghost" href={lavoriHref}>{casesCta} <span class="arrow">→</span></a>
    </div>
  </div>
</section>

<ProductsTeaser lang={lang} />
<Process lang={lang} />
<Ai lang={lang} />
<Manifesto lang={lang} />
<Coverage lang={lang} />
<CtaFinal lang={lang} />
