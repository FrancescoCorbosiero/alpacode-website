---
import type { Lang } from "../../i18n/types";
import { localizePath } from "../../i18n/utils";
import { business } from "../../data/business";
import BookCall from "../BookCall.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const lavoriHref = localizePath("lavori", lang);

const t =
  lang === "it"
    ? {
        eyebrow: "MZ · MI — IT · EST. 2025",
        status: "IN COSTRUZIONE",
        tagline: "Il web è cambiato.",
        sub: "Stiamo costruendo qualcosa di nuovo. Nel frattempo parliamone — la prima call è gratuita e senza impegno.",
        book: "Prenota una call",
        work: "Guarda i lavori",
      }
    : {
        eyebrow: "MZ · MI — IT · EST. 2025",
        status: "UNDER CONSTRUCTION",
        tagline: "The web has changed.",
        sub: "We're building something new. In the meantime, let's talk — the first call is free and no-strings.",
        book: "Book a call",
        work: "See the work",
      };
---

<section class="wip">
  <div class="wrap-wide">
    <div class="wip-top">
      <span class="eyebrow">{t.eyebrow}</span>
      <span class="eyebrow wip-status">{t.status}</span>
    </div>

    <h1 class="wip-wordmark">
      <span class="row">ALPACODE</span>
      <span class="wip-bar" aria-hidden="true"></span>
      <span class="row wip-sub-word">SOLUZIONI DIGITALI</span>
    </h1>

    <p class="wip-tagline">{t.tagline}</p>
    <p class="wip-sub">{t.sub}</p>

    <div class="wip-ctas">
      <BookCall label={t.book} journey="wip" class="btn-blue" />
      <a class="btn btn-ghost" href={lavoriHref}>{t.work}</a>
    </div>

    <div class="wip-meta">
      <a href={`mailto:${business.email}`}>{business.email}</a>
      <span>Monza · Milano · IT</span>
    </div>
  </div>
</section>
