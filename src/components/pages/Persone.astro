---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang } from "../../i18n/types";
import { team, personeCopy } from "../../data/team";
import PageHero from "../PageHero.astro";
import CtaFinal from "../home/CtaFinal.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Drop a file named <id>.<ext> into src/assets/team/ (e.g. francesco.jpg) and
// it's picked up, optimized, automatically. Otherwise the monogram shows.
const teamImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/team/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);
const imgFor = (id: string): ImageMetadata | undefined =>
  Object.entries(teamImages).find(
    ([p]) => p.split("/").pop()?.replace(/\.[^.]+$/, "") === id,
  )?.[1].default;

const people = team.map((p) => ({ ...p, img: imgFor(p.id) }));
---

<PageHero
  crumb={personeCopy.crumb[lang]}
  line1={personeCopy.line1[lang]}
  line2={personeCopy.line2[lang]}
  lede={personeCopy.lede[lang]}
/>

<section class="section people-section">
  <div class="wrap-wide">
    <div class="people-grid">
      {
        people.map((p) => (
          <article class="person">
            <div class="person-photo">
              {p.img ? (
                <Image
                  src={p.img}
                  alt={p.name}
                  widths={[320, 560, 800]}
                  sizes="(max-width: 760px) 100vw, 33vw"
                  class="img-fill"
                />
              ) : (
                <div class="person-mono" role="img" aria-label={p.name}>
                  <span>{p.initials}</span>
                  <span class="person-mono-note">{personeCopy.photoLabel[lang]}</span>
                </div>
              )}
            </div>
            <div class="person-strut" aria-hidden="true" />
            <h2 class="person-name">{p.name}</h2>
            <div class="person-role">{p.role[lang]}</div>
            {p.note && <p class="person-note">{p.note[lang]}</p>}
          </article>
        ))
      }
    </div>
  </div>
</section>

<CtaFinal lang={lang} />
