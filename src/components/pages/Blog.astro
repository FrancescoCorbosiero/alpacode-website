---
import { getCollection } from "astro:content";
import type { Lang } from "../../i18n/types";
import { localizePath } from "../../i18n/utils";
import PageHero from "../PageHero.astro";
import CtaFinal from "../home/CtaFinal.astro";
import BlogList from "../islands/BlogList.tsx";
import type { BlogPost, TopicTab, BlogLabels } from "../islands/BlogList";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const all = (await getCollection("blog")).sort((a, b) => a.data.order - b.data.order);

const posts: BlogPost[] = all.map((p) => ({
  id: p.id,
  href: localizePath(`blog/${p.id}`, lang),
  title: p.data.title[lang],
  descriptor: p.data.descriptor[lang],
  date: p.data.date[lang],
  category: p.data.category[lang],
  topic: p.data.topic,
}));

const tabs: TopicTab[] =
  lang === "it"
    ? [
        { key: "all", label: "Tutti" },
        { key: "strategy", label: "Strategia" },
        { key: "craft", label: "Mestiere" },
        { key: "perspectives", label: "Sguardi" },
      ]
    : [
        { key: "all", label: "All" },
        { key: "strategy", label: "Strategy" },
        { key: "craft", label: "Craft" },
        { key: "perspectives", label: "Perspectives" },
      ];

const labels: BlogLabels =
  lang === "it"
    ? {
        featured: "In evidenza",
        read: "Leggi l'articolo",
        empty: "Nessun articolo in questa sezione, per ora.",
        filter: "Filtra per tema",
      }
    : {
        featured: "Featured",
        read: "Read the article",
        empty: "No articles in this section yet.",
        filter: "Filter by topic",
      };

const t =
  lang === "it"
    ? {
        crumb: "06 · BLOG",
        line1: "Note,",
        line2: "guide e pensieri.",
        lede: "Quello che impariamo lo scriviamo. Strategie, mestiere e sguardi sul digitale — scegli da dove vuoi partire.",
      }
    : {
        crumb: "06 · BLOG",
        line1: "Notes,",
        line2: "guides and thoughts.",
        lede: "What we learn we write. Strategy, craft and perspectives on digital — pick where to start.",
      };
---

<PageHero crumb={t.crumb} line1={t.line1} line2={t.line2} lede={t.lede} />

<section class="section" style="padding-top:24px">
  <div class="wrap-wide">
    <BlogList client:load posts={posts} tabs={tabs} labels={labels} />
  </div>
</section>

<CtaFinal lang={lang} />
