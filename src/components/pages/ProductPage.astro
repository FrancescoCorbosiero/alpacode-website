---
import type { Lang } from "../../i18n/types";
import type { ProductPage } from "../../data/product-pages";
import { localizePath } from "../../i18n/utils";
import BookCall from "../BookCall.astro";

interface Props {
  lang: Lang;
  /** Visual theme: hive = dark + yellow, pro-kit = paper + coral red,
   *  paco = dark + WhatsApp green. */
  variant: "hive" | "pro-kit" | "paco";
  data: ProductPage;
}
const { lang, variant, data: t } = Astro.props;
const stageTag = { hive: "HIVE.DASH", "pro-kit": "PROKIT.APP", paco: "PACO.CHAT" }[variant];
const prodottiHref = localizePath("prodotti", lang);
const variantClass = `pp pp--${variant}`;
---

<div class={variantClass}>
  {/* ---------- HERO ---------- */}
  <section class="pp-hero">
    <div class="wrap-wide">
      <div class="pp-hero-top">
        <a class="pp-crumb" href={prodottiHref}>{t.crumb}</a>
        <span class="pp-eyebrow">
          <span class="pp-dot" aria-hidden="true"></span>{t.eyebrow}
        </span>
      </div>

      <h1 class="pp-h1">
        <span class="pp-h1-bar" aria-hidden="true"></span>
        <span class="pp-h1-line">{t.h1Line1}</span>
        <span class="pp-h1-line pp-h1-line--accent">{t.h1Line2}</span>
      </h1>

      <div class="pp-hero-tail">
        <p class="pp-lede">{t.lede}</p>
        <div class="pp-hero-ctas">
          <BookCall label={t.ctaPrimary} journey={`${variant}-hero`} lang={lang} class="btn-accent" />
          <a class="btn btn-ghost-on-dark" href={`mailto:info@alpacode.it?subject=${encodeURIComponent(t.ctaSecondary)}`}>
            {t.ctaSecondary} <span class="arrow">→</span>
          </a>
        </div>
      </div>

      {/* Hero visual placeholder — drop a real screenshot / mockup later */}
      <div class="pp-hero-stage" aria-hidden="true">
        <div class="pp-hero-stage-grid"></div>
        <div class="pp-hero-stage-card">
          <div class="pp-hero-stage-card-row pp-hero-stage-card-row--1"></div>
          <div class="pp-hero-stage-card-row pp-hero-stage-card-row--2"></div>
          <div class="pp-hero-stage-card-row pp-hero-stage-card-row--3"></div>
          <div class="pp-hero-stage-card-row pp-hero-stage-card-row--4"></div>
        </div>
        <div class="pp-hero-stage-tag">{stageTag}</div>
      </div>

      <div class="pp-hero-meta">
        {
          t.heroMeta.map((m, i) => (
            <div class="pp-hero-cell" style={`--cell-i:${i}`}>
              <span class="k">{m.k}</span>
              <span class="v">{m.v}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- PITCH ---------- */}
  <section class="pp-section pp-pitch">
    <div class="wrap-wide">
      <div class="pp-sec-num">{t.pitchEyebrow}</div>
      <h2 class="pp-pitch-lead">{t.pitchLead}</h2>
      <p class="pp-pitch-body">{t.pitchBody}</p>
    </div>
  </section>

  {/* ---------- FEATURES ---------- */}
  <section class="pp-section pp-features">
    <div class="wrap-wide">
      <div class="pp-section-head">
        <div>
          <div class="pp-sec-num">{t.featuresEyebrow}</div>
          <h2 class="pp-h2">{t.featuresHeading}</h2>
        </div>
      </div>
      <div class="pp-features-grid">
        {
          t.features.map((f) => (
            <article class="pp-feature">
              <div class="pp-feature-top">
                <span class="pp-feature-n">{f.n}</span>
                <span class="pp-feature-strut" aria-hidden="true"></span>
              </div>
              <h3 class="pp-feature-t">{f.t}</h3>
              <p class="pp-feature-d">{f.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- EARLY ACCESS ---------- */}
  <section class="pp-section pp-section--invert pp-ea">
    <div class="wrap-wide">
      <div class="pp-section-head">
        <div>
          <div class="pp-sec-num">{t.eaEyebrow}</div>
          <h2 class="pp-h2">{t.eaHeading}</h2>
        </div>
        <p class="pp-lede pp-lede--inline">{t.eaLede}</p>
      </div>
      <div class="pp-ea-grid">
        {
          t.eaPerks.map((p) => (
            <div class="pp-ea-perk">
              <div class="pp-ea-n">{p.n}</div>
              <div class="pp-ea-strut" aria-hidden="true"></div>
              <h3 class="pp-ea-t">{p.t}</h3>
              <p class="pp-ea-d">{p.d}</p>
            </div>
          ))
        }
      </div>
      <div class="pp-ea-cta">
        <BookCall label={t.eaCta} journey={`${variant}-ea`} lang={lang} class="btn-accent" />
      </div>
    </div>
  </section>

  {/* ---------- FINAL CTA ---------- */}
  <section class="pp-section pp-cta-final">
    <div class="wrap-wide">
      <div class="pp-sec-num">{t.ctaFinalEyebrow}</div>
      <div class="pp-cta-display">
        {t.ctaFinalLine1}<br /><span class="pp-cta-underline">{t.ctaFinalLine2}</span>
      </div>
      <p class="pp-cta-sub">{t.ctaFinalSub}</p>
      <div class="pp-cta-actions">
        <BookCall label={t.ctaFinalCta} journey={`${variant}-cta-final`} lang={lang} class="btn-accent btn-lg" />
        <a class="btn btn-ghost-on-dark" href={prodottiHref}>{t.ctaFinalAlt} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  {/* ---------- STICKY CTA PILL ---------- */}
  <div class="pp-sticky" data-pp-sticky>
    <BookCall label={t.stickyCta} journey={`${variant}-sticky`} lang={lang} class="pp-sticky-btn" arrow={true} />
  </div>
</div>

<script is:inline>
  /* Show the sticky CTA only after the user scrolls past the hero. */
  (function () {
    const init = () => {
      const sticky = document.querySelector("[data-pp-sticky]");
      const hero = document.querySelector(".pp-hero");
      if (!sticky || !hero) return;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            sticky.classList.toggle("is-visible", !e.isIntersecting);
          });
        },
        { threshold: 0, rootMargin: "-60px 0px 0px 0px" },
      );
      io.observe(hero);
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
    document.addEventListener("astro:page-load", init);
  })();
</script>
