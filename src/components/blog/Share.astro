---
import type { Lang } from "../../i18n/types";

interface Props {
  url: string;
  title: string;
  lang: Lang;
}
const { url, title, lang } = Astro.props;

const t =
  lang === "it"
    ? { label: "Condividi", copy: "Copia link", copied: "Copiato!", x: "Condividi su X", li: "Condividi su LinkedIn" }
    : { label: "Share", copy: "Copy link", copied: "Copied!", x: "Share on X", li: "Share on LinkedIn" };

const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
const liHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---

<div class="share" data-share data-copy-label={t.copy} data-copied-label={t.copied}>
  <span class="share-label">{t.label}</span>
  <div class="share-row">
    <button type="button" class="share-btn" data-copy-link aria-label={t.copy}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
        <rect x="9" y="9" width="11" height="11"></rect>
        <path d="M5 15V4h11"></path>
      </svg>
      <span data-copy-text>{t.copy}</span>
    </button>
    <a class="share-btn" href={xHref} target="_blank" rel="noopener noreferrer" aria-label={t.x}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.244 3H21l-6.51 7.44L22 21h-6.832l-4.51-5.66L5.5 21H2.74l7-7.99L2 3h6.91l4.07 5.18L18.244 3zm-1.197 16h1.59L7.05 5H5.34l11.707 14z"></path>
      </svg>
      <span>X</span>
    </a>
    <a class="share-btn" href={liHref} target="_blank" rel="noopener noreferrer" aria-label={t.li}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M4.98 3.5a2.5 2.5 0 1 1-.02 5.001A2.5 2.5 0 0 1 4.98 3.5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-1 1.83-2.06 3.77-2.06 4.04 0 4.78 2.66 4.78 6.13V21h-4v-5.4c0-1.29-.02-2.94-1.8-2.94-1.8 0-2.08 1.4-2.08 2.85V21h-4V9z"></path>
      </svg>
      <span>LinkedIn</span>
    </a>
  </div>
</div>
