---
/* A note in the margin, in the studio's hand (Caveat). With `arrow`, a
   pen stroke points from the note to what it's about. Brings its face
   along: only the pages that write in the margin load it. */
import "@fontsource/caveat/600.css";

interface Props {
  arrow?: "right" | "left" | "down" | "down-left" | "up";
  kicker?: boolean;
  class?: string;
  tag?: "span" | "p" | "div";
}
const { arrow, kicker = false, class: cls, tag: Tag = kicker ? "p" : "span" } = Astro.props;
const ARROWS = {
  right: "M4 26 C 18 12, 38 8, 58 15 M49 7 L 59 15 L 49 22",
  left: "M60 26 C 46 12, 26 8, 6 15 M15 7 L 5 15 L 15 22",
  down: "M10 4 C 30 6, 44 18, 46 36 M38 29 L 46 37 L 53 28",
  "down-left": "M56 4 C 36 6, 20 16, 14 36 M8 27 L 14 37 L 22 30",
  up: "M10 36 C 28 34, 42 22, 46 4 M38 10 L 46 3 L 53 12",
};
---

<Tag class:list={["lnd-hand", { "lnd-hand--kicker": kicker }, cls]} data-hand>
  <slot />{
    arrow && (
      <svg class="lnd-arrow" viewBox="0 0 64 40" aria-hidden="true" focusable="false" data-arrow={arrow}>
        <path d={ARROWS[arrow]} />
      </svg>
    )
  }
</Tag>
