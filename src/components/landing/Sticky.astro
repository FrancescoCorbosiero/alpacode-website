---
/* The call to action that follows the reader once the hero is gone and
   steps aside on the form (lib/sticky.ts). */
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<div class="lnd-sticky" data-sticky>
  <a class="btn btn-ac" href={href}>{label} <span class="arrow" aria-hidden="true">→</span></a>
</div>

<script>
  import "../../lib/sticky";
</script>
