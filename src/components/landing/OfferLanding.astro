---
/* /offerta/<slug> — one template, a page per audience (data/campaigns.ts).
   The pen corrects the hero's second line; a search where the reader's
   clients finally find them; Italy's gap in bars; the proposal sheet;
   the steps; open answers; the form (lib/landing/offer.ts keeps the
   tabs and the form's choice in step). */
import "../../styles/landing.css";
import type { ImageMetadata } from "astro";
import type { Lang } from "../../i18n/types";
import { COPY, FAQ, PROMISES, SEARCH, STATS, STEPS, how, offerVariants, t, type Campaign } from "../../data/campaigns";
import { portals, siblings } from "../../data/audiences";
import RemoteImage from "../RemoteImage.astro";
import Mark from "./Mark.astro";
import Hand from "./Hand.astro";
import Lines from "./Lines.astro";
import Objections from "./Objections.astro";
import LeadForm from "./LeadForm.astro";
import Portals from "./Portals.astro";

interface Props {
  lang: Lang;
  campaign: Campaign;
}
const { lang, campaign: c } = Astro.props;
const variants = offerVariants(c.price);
const H = how(c.price);
const tr = <T,>(v: Record<Lang, T>) => t(v, lang);

// A photo dropped in src/assets/campaigns/<slug>.<ext> overrides the hotlink.
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/campaigns/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);
const local = Object.entries(images).find(
  ([p]) => p.split("/").pop()?.replace(/\.[^.]+$/, "") === c.heroImage.id,
)?.[1].default;

/* The hero's second line, with the pen's correction when there is one. */
const line2 = tr(c.hero.line2);
const fix = c.hero.fix && line2.includes(tr(c.hero.fix.strike)) ? c.hero.fix : undefined;
const [fixBefore, fixAfter] = fix ? line2.split(tr(fix.strike)) : ["", ""];
const plain = line2.replace(/[.?!]$/, "");
const stop = line2.slice(plain.length);

const pct = (n: number) => `${String(n).replace(".", lang === "it" ? "," : ".")}%`;
const audience = tr(c.audience);
---

<div class="lnd lnd--offer">
  {/* ---------- Hero ---------- */}
  <section class="lnd-plate lnd-plate--print lnd-hero lnd-hero--offer" data-hero>
    <div class="lnd-crop" aria-hidden="true"></div>
    <div class="lnd-wrap lnd-offer-hero">
      <div class="lnd-offer-hero-copy">
        <Hand kicker><span data-intro style="--i:0">{tr(c.eyebrow)}</span></Hand>
        <h1 class="lnd-display">
          <span style="--i:0">{tr(c.hero.line1)}</span>
          {
            fix ? (
              <span class="lnd-ac lnd-fixline" style="--i:1">
                {fixBefore}
                <span class="lnd-fix">
                  <Mark kind="strike">{tr(fix.strike)}</Mark>
                  {tr(fix.write) && (
                    <span class="lnd-fix-write" aria-hidden="true">
                      {tr(fix.write)}
                    </span>
                  )}
                </span>
                {fixAfter}
              </span>
            ) : (
              <span class="lnd-ac" style="--i:1">
                <Mark kind="underline">{plain}</Mark>
                {stop}
              </span>
            )
          }
        </h1>
        <p class="lnd-lede" data-intro style="--i:2">{tr(c.hero.lede)}</p>
        <div class="lnd-actions" data-intro style="--i:3">
          <a class="btn btn-ac btn-lg" href="#parliamone" data-magnetic>{tr(COPY.ctaPrimary)} <span class="arrow">→</span></a>
          <a class="lnd-link" href="#offerta">{tr(COPY.ctaSecondary)} <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <figure class="lnd-offer-photo" data-intro style="--i:2">
        <RemoteImage local={local} src={c.heroImage.src} alt={tr(c.heroImage.alt)} placeholder={audience} loading="eager" ratio="4 / 5" />
        <span class="lnd-price-tag" aria-hidden="true">
          <strong>{c.price} €</strong>
          <span>{tr(COPY.perYear)}</span>
        </span>
      </figure>
    </div>
  </section>

  {/* ---------- Found: what their clients search, and find ---------- */}
  <section class="lnd-scene lnd-found" data-scene="found" style="--len:3" aria-label={tr(c.search)}>
    <div class="lnd-stage">
      <div class="lnd-wrap lnd-found-grid">
        <div class="lnd-beats">
          {
            c.pains.map((p) => (
              <div class="lnd-beat">
                <h2 class="lnd-title lnd-title--md">{tr(p.k)}</h2>
                <p class="lnd-lede">{tr(p.v)}</p>
              </div>
            ))
          }
        </div>
        <div class="lnd-phone" aria-hidden="true">
          <div class="lnd-serp">
            <div class="lnd-serp-bar">
              <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L21 21"></path></svg>
              <span class="lnd-serp-q">{tr(c.search)}</span>
            </div>
            <ol class="lnd-serp-list">
              <li class="lnd-serp-item">
                <span class="lnd-serp-k">{tr(SEARCH.others[0].k)}</span>
                <b>{tr(SEARCH.others[0].t)}</b>
                <i></i>
              </li>
              <li class="lnd-serp-item lnd-serp-item--you">
                <span class="lnd-serp-k">{tr(SEARCH.you.k)}</span>
                <b>{tr(SEARCH.you.t)}</b>
                <i></i>
                <span class="lnd-hand lnd-serp-hand">{tr(SEARCH.you.hand)}</span>
              </li>
              {
                SEARCH.others.slice(1).map((o) => (
                  <li class="lnd-serp-item">
                    <span class="lnd-serp-k">{tr(o.k)}</span>
                    <b>{tr(o.t)}</b>
                    <i />
                  </li>
                ))
              }
            </ol>
            <div class="lnd-serp-site">
              <span class="lnd-serp-k">{tr(SEARCH.you.k)}</span>
              <b>{tr(SEARCH.you.t)}</b>
              <ul>{tr(SEARCH.sections).map((s) => <li>{s}</li>)}</ul>
            </div>
          </div>
        </div>
      </div>
      <div class="lnd-progress" aria-hidden="true"></div>
    </div>
  </section>

  {/* ---------- Why now ---------- */}
  <section class="lnd-plate lnd-plate--ink lnd-stats">
    <div class="lnd-wrap">
      <Hand kicker>{tr(COPY.statsKicker)}</Hand>
      <div class="lnd-stats-head">
        <h2 class="lnd-title" data-split><Lines text={tr(COPY.statsTitle)} /></h2>
        <p class="lnd-lede" data-reveal>{tr(COPY.statsLede)}</p>
      </div>
      <ul class="lnd-stat-list" data-scene="bars">
        {
          STATS.map((s) => (
            <li class="lnd-stat">
              <strong class="lnd-stat-v">{s.value}</strong>
              <p class="lnd-stat-l">{tr(s.label)}</p>
              {s.bar && (
                <div class="lnd-vs">
                  <span>{tr(COPY.italy)}</span>
                  <i style={`--v:${s.bar.it / 100}`} />
                  <b>{pct(s.bar.it)}</b>
                  <span>{tr(COPY.eu)}</span>
                  <i class="lnd-vs-eu" style={`--v:${s.bar.eu / 100}`} />
                  <b>{pct(s.bar.eu)}</b>
                </div>
              )}
              <span class="lnd-stat-src">{s.source}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------- How we work ---------- */}
  <section class="lnd-plate lnd-how">
    <div class="lnd-wrap lnd-how-grid">
      <div>
        <Hand kicker>{tr(H.kicker)}</Hand>
        <h2 class="lnd-title" data-split><Lines text={tr(H.title)} /></h2>
        <p class="lnd-lede lnd-how-lede" data-reveal>{tr(H.lede)}</p>
      </div>
      <ol class="lnd-how-points">
        {
          H.points.map((p) => (
            <li data-reveal>
              <h3 class="lnd-sub">{tr(p.k)}</h3>
              <p class="lnd-body">{tr(p.v)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------- The proposal ---------- */}
  <section class="lnd-plate lnd-plate--paper-2 lnd-offer" id="offerta" data-offer>
    <div class="lnd-wrap lnd-offer-grid">
      <div class="lnd-offer-copy">
        <h2 class="lnd-title" data-split><Lines text={tr(COPY.offerTitle)} /></h2>
        <div class="lnd-tabs" role="tablist" aria-label={tr(COPY.offerTitle).replace("\n", " ")}>
          {
            variants.map((v, i) => (
              <button
                class="lnd-tab"
                type="button"
                role="tab"
                id={`tab-${v.id}`}
                aria-controls={`sheet-${v.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                data-variant={v.id}
              >
                {tr(v.tab)}
              </button>
            ))
          }
        </div>
        {
          variants.map((v, i) => (
            <p class="lnd-lede lnd-offer-blurb" data-blurb={v.id} hidden={i !== 0}>
              {tr(v.blurb)}
            </p>
          ))
        }
        <ol class="lnd-terms">
          {
            PROMISES.map((p) => (
              <li data-reveal>
                <h3>{tr(p.t)}</h3>
                <p>{tr(p.d)}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="lnd-sheet-wrap">
        {
          variants.map((v, i) => (
            <article class="lnd-sheet" id={`sheet-${v.id}`} role="tabpanel" aria-labelledby={`tab-${v.id}`} data-panel={v.id} hidden={i !== 0}>
              <header class="lnd-sheet-head">
                <span>{tr(COPY.proposal)}</span>
                <span>{audience}</span>
              </header>
              <h3 class="lnd-sheet-title">{tr(v.headline)}</h3>
              <div class="lnd-sheet-price">
                <strong>{c.price} €</strong>
                <span>{tr(COPY.perYear)}</span>
              </div>
              <p class="lnd-sheet-note">{tr(v.priceNote)}</p>
              <p class="lnd-sheet-k">{tr(COPY.includesLabel)}</p>
              <ul class="lnd-sheet-list">
                {v.includes.map((it) => (
                  <li>{tr(it)}</li>
                ))}
              </ul>
              <a class="btn btn-ac" href="#parliamone" data-pick-tier={v.id}>
                {tr(COPY.ctaPrimary)} <span class="arrow">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- Steps ---------- */}
  <section class="lnd-plate lnd-steps-plate">
    <div class="lnd-wrap">
      <h2 class="lnd-title" data-split><Lines text={tr(COPY.stepsTitle)} /></h2>
      <ol class="lnd-track">
        {
          STEPS.map((s) => (
            <li class="lnd-track-step" data-reveal>
              <span class="lnd-track-dot" aria-hidden="true" />
              <h3 class="lnd-sub">{tr(s.t)}</h3>
              <p class="lnd-body">{tr(s.d)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Objections title={tr(COPY.faqTitle)} items={FAQ.map((f) => ({ q: tr(f.q), a: tr(f.a) }))} />

  <LeadForm
    lang={lang}
    campaign={c.slug}
    audience={audience}
    topic={`Offerta · ${audience}`}
    title={tr(COPY.formTitle)}
    lede={tr(COPY.formLede)}
    choices={variants.map((v) => ({ id: v.id, name: tr(v.tab) }))}
    choiceLegend={tr(COPY.choiceLegend)}
    unsure={false}
    phone
    price={`${c.price} €/anno`}
    message={{
      label: lang === "it" ? "Due righe su di te (facoltativo)" : "A couple of lines about you (optional)",
      ph: lang === "it" ? "Cosa fai, cosa ti serve." : "What you do, what you need.",
    }}
  />

  <Portals title={tr(COPY.portals)} items={portals(siblings(`offerta/${c.slug}`, "attivita").slice(0, 3), lang)} />
</div>

<script>
  import "../../lib/landing/offer";
  import "../../lib/landing/formula";
</script>
