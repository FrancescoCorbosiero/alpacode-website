---
/* The formula — three steps up: the codebase alone, the course with the
   codebase, 1:1 training. Each step carries the one below. The tier the
   reader's profile points to is marked (lib/landing/profile.ts); picking
   one fills the lead form's choice (lib/landing/formula.ts). */
import type { FormulaCopy, ProfileId } from "../../data/landing/shared";
import Hand from "./Hand.astro";
import Lines from "./Lines.astro";

interface Props {
  copy: FormulaCopy;
  /** The lead form's anchor. */
  formHref: string;
  id?: string;
  profile?: ProfileId;
}
const { copy: f, formHref, id = "formula", profile = "dev" } = Astro.props;
---

<section
  class="lnd-plate lnd-plate--paper-2 lnd-formula"
  id={id}
  data-formula
  data-recommend-dev={f.recommend.dev}
  data-recommend-designer={f.recommend.designer}
>
  <div class="lnd-wrap">
    <div class="lnd-formula-head">
      <h2 class="lnd-title" data-split><Lines text={f.title} /></h2>
      <div>
        <p class="lnd-lede" data-reveal>{f.lede}</p>
        <slot />
      </div>
    </div>
    <ol class="lnd-steps" data-steps>
      {
        f.tiers.map((t, i) => (
          <li
            class:list={["lnd-tier", { "is-recommended": t.id === f.recommend[profile] }]}
            style={`--level:${i}`}
            data-tier={t.id}
          >
            <Hand class="lnd-tier-badge" arrow="down-left">
              {f.badge}
            </Hand>
            <p class="lnd-tier-level">{t.level}</p>
            <h3 class="lnd-tier-name">{t.name}</h3>
            <p class="lnd-tier-line">{t.line}</p>
            <p class="lnd-tier-for">{t.forWho}</p>
            <ul>
              {t.carry && <li class="is-carry">{t.carry}</li>}
              {t.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
            <a class="btn btn-line" href={formHref} data-pick-tier={t.id}>
              {t.cta} <span class="arrow">→</span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="lnd-formula-note">{f.note}</p>
  </div>
</section>

<script>
  import "../../lib/landing/formula";
</script>
