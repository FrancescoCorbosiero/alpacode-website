---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Production image slot. When a real image is provided it renders an optimized
// <Image> (WebP/AVIF + srcset); otherwise it shows the dashed placeholder.
interface Props {
  placeholder: string;
  src?: ImageMetadata;
  alt?: string;
  class?: string;
}
const { placeholder, src, alt = "", class: cls } = Astro.props;
---

{
  src ? (
    <div class:list={["img-slot", "is-filled", cls]}>
      <Image
        src={src}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 900px) 100vw, 50vw"
        class="img-fill"
      />
    </div>
  ) : (
    <div class:list={["img-slot", cls]} role="img" aria-label={placeholder}>
      <span>{placeholder}</span>
    </div>
  )
}
