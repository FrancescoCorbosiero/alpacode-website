---
/* Credentials section shared by the conversion landings.
   Palette-agnostic: colors come from --lpt-* variables that each
   landing maps to its own scoped palette (see smm/ptn stylesheets).
   Images are optional: drop src/assets/trust/<id>.<ext> to fill a
   slot; until then a clean bordered placeholder renders. */
import type { Lang } from "../i18n/types";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { TRUST_BADGES, TRUST_PROOF, TRUST_CLAIMS } from "../data/trust";

interface Props {
  lang: Lang;
  kicker: string;
  title: string;
  lede: string;
}
const { lang, kicker, title, lede } = Astro.props;

const trustImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/trust/*.{jpg,jpeg,png,webp,avif,svg,JPG,JPEG,PNG,WEBP,AVIF,SVG}",
  { eager: true },
);
const localImg = (id: string): ImageMetadata | undefined =>
  Object.entries(trustImages).find(
    ([p]) => p.split("/").pop()?.replace(/\.[^.]+$/, "") === id,
  )?.[1].default;

const claims = TRUST_CLAIMS[lang];
---

<div class="wrap-wide">
  <div class="section-head lp-trust-head">
    <div>
      <div class="sec-num lp-trust-kicker">{kicker}</div>
      <h2>{title}</h2>
    </div>
    <p class="lede">{lede}</p>
  </div>

  <div class="lp-trust-grid">
    <div class="lp-trust-claims">
      {
        claims.map((cl) => (
          <div class="lp-trust-claim">
            <span class="lp-trust-strut" aria-hidden="true"></span>
            <h3>{cl.t}</h3>
            <p>{cl.d}</p>
          </div>
        ))
      }
    </div>

    <div class="lp-trust-proofs">
      {
        TRUST_PROOF.map((p) => {
          const img = localImg(p.id);
          return (
            <figure class="lp-trust-proof">
              {img ? (
                <Image src={img} alt={p.caption[lang]} class="lp-trust-img" widths={[480, 760]} sizes="(max-width: 900px) 90vw, 40vw" />
              ) : (
                <div class="lp-trust-ph" aria-hidden="true">
                  <span>{p.caption[lang]}</span>
                </div>
              )}
              <figcaption>{p.caption[lang]}</figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>

  <div class="lp-trust-badges" aria-label={lang === "it" ? "Certificazioni e piattaforme" : "Certifications and platforms"}>
    {
      TRUST_BADGES.map((b) => {
        const img = localImg(b.id);
        return (
          <div class="lp-trust-badge">
            {img ? (
              <Image src={img} alt={b.label[lang]} class="lp-trust-badge-img" width={200} />
            ) : (
              <span class="lp-trust-badge-ph">{b.label[lang]}</span>
            )}
          </div>
        );
      })
    }
  </div>
</div>
