---
import Layout from "../../components/Layout.astro";
import BuildersHub from "../../components/landing/BuildersHub.astro";
import { hub } from "../../data/landing/hub";
import { breadcrumbSchema } from "../../lib/schema";
import { localizePath } from "../../i18n/utils";

const lang = "it" as const;
const c = hub[lang];
const site = Astro.site ?? new URL("https://alpacode.it");
const url = (slug: string) => new URL(localizePath(slug, lang), site).href;
---

<Layout
  lang={lang}
  slug="per-chi-fa-siti"
  title={c.meta.title}
  description={c.meta.description}
  ogImage="/og-per-chi-fa-siti.png"
  ogAlt={c.meta.ogAlt}
  jsonLd={[breadcrumbSchema([{ name: "Alpacode", url: url("") }, { name: c.crumb, url: url("per-chi-fa-siti") }])]}
  themeColor="#f0f3f9"
>
  <BuildersHub lang={lang} />
</Layout>
