---
import Layout from "../components/Layout.astro";
import CollaboraConNoi from "../components/pages/CollaboraConNoi.astro";
import { collabora } from "../data/collabora-con-noi";
import { meta } from "../i18n/ui";
import { faqPageSchema } from "../lib/schema";

const lang = "it" as const;
const t = collabora[lang];
const m = meta["collabora-con-noi"];
const faqSchema = faqPageSchema(t.faq);
---

<Layout
  lang={lang}
  active="collabora-con-noi"
  slug="collabora-con-noi"
  title={m.title[lang]}
  description={m.description[lang]}
  jsonLd={[faqSchema]}
>
  <CollaboraConNoi lang={lang} />
</Layout>
