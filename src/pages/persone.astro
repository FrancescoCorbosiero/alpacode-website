import Persone from "../components/pages/Persone.astro";
import { meta } from "../i18n/ui";
const lang = "it" as const;
const m = meta.persone;
---

<Layout lang={lang} active="persone" slug="persone" title={m.title[lang]} description={m.description[lang]}>
  <Persone lang={lang} />
</Layout>
