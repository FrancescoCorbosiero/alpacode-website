---
import Layout from "../components/Layout.astro";
import Home from "../components/pages/Home.astro";
import { meta } from "../i18n/ui";
const lang = "it" as const;
const m = meta.home;
---

<Layout
  lang={lang}
  slug="anteprima"
  title={`Anteprima · ${m.title[lang]}`}
  description={m.description[lang]}
  noindex
>
  <Home lang={lang} />
</Layout>
