---
import Layout from "../../components/Layout.astro";
import Offerta from "../../components/pages/Offerta.astro";
import { CAMPAIGNS, COPY, FAQ, t, type Campaign } from "../../data/campaigns";
import { faqPageSchema } from "../../lib/schema";

export function getStaticPaths() {
  return CAMPAIGNS.map((campaign) => ({
    params: { slug: campaign.slug },
    props: { campaign },
  }));
}

const lang = "it" as const;
const { campaign } = Astro.props as { campaign: Campaign };
const slug = `offerta/${campaign.slug}`;
const faqSchema = faqPageSchema(FAQ.map((f) => ({ q: t(f.q, lang), a: t(f.a, lang) })));
---

<Layout
  lang={lang}
  slug={slug}
  title={t(campaign.meta.title, lang)}
  description={t(campaign.meta.description, lang)}
  jsonLd={[faqSchema]}
  minimal
  ctaLabel={t(COPY.ctaPrimary, lang)}
>
  <Offerta lang={lang} campaign={campaign} />
</Layout>
