---
import Layout from "../../components/Layout.astro";
import OfferLanding from "../../components/landing/OfferLanding.astro";
import { CAMPAIGNS, COPY, FAQ, t, type Campaign } from "../../data/campaigns";
import { landingJsonLd } from "../../lib/landing/schema";

export function getStaticPaths() {
  return CAMPAIGNS.map((campaign) => ({
    params: { slug: campaign.slug },
    props: { campaign },
  }));
}

const lang = "it" as const;
const { campaign } = Astro.props as { campaign: Campaign };
const slug = `offerta/${campaign.slug}`;
---

<Layout
  lang={lang}
  slug={slug}
  title={t(campaign.meta.title, lang)}
  description={t(campaign.meta.description, lang)}
  jsonLd={landingJsonLd({
    lang,
    site: Astro.site ?? new URL("https://alpacode.it"),
    crumbs: [{ name: t(campaign.audience, lang), slug }],
    faq: FAQ.map((f) => ({ q: t(f.q, lang), a: t(f.a, lang) })),
  })}
  minimal
  themeColor="#f0f3f9"
  ctaLabel={t(COPY.ctaPrimary, lang)}
  ctaHref="#parliamone"
>
  <OfferLanding lang={lang} campaign={campaign} />
</Layout>
