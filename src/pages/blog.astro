---
import Layout from "../components/Layout.astro";
import Blog from "../components/pages/Blog.astro";
import { meta } from "../i18n/ui";
const lang = "it" as const;
const m = meta.blog;
---

<Layout lang={lang} active="blog" slug="blog" title={m.title[lang]} description={m.description[lang]}>
  <Blog lang={lang} />
</Layout>
