---
import Layout from "../../components/Layout.astro";
import Faq from "../../components/pages/Faq.astro";
import { meta } from "../../i18n/ui";
import { faqEntries } from "../../data/faq";
import { faqPageSchema } from "../../lib/schema";
const lang = "en" as const;
const m = meta.faq;
const jsonLd = [faqPageSchema(faqEntries(lang))];
---

<Layout lang={lang} active="faq" slug="faq" title={m.title[lang]} description={m.description[lang]} jsonLd={jsonLd}>
  <Faq lang={lang} />
</Layout>
