---
import Layout from "../../components/Layout.astro";
import PartnerLanding from "../../components/landing/PartnerLanding.astro";
import { partnerLanding } from "../../data/partner-landing";
import { landingJsonLd } from "../../lib/landing/schema";

const lang = "en" as const;
const c = partnerLanding[lang];
const CRUMB = { it: "Programma partner", en: "Partner program" };
---

<Layout
  lang={lang}
  slug="partner"
  title={c.title}
  description={c.description}
  ogImage={c.ogImage}
  ogAlt={c.ogAlt}
  jsonLd={landingJsonLd({
    lang,
    site: Astro.site ?? new URL("https://alpacode.it"),
    crumbs: [{ name: CRUMB[lang], slug: "partner" }],
    faq: c.qa.items,
  })}
  themeColor="#f0f3f9"
>
  <PartnerLanding lang={lang} />
</Layout>
