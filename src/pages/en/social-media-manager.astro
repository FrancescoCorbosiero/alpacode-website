---
import Layout from "../../components/Layout.astro";
import SmmLanding from "../../components/landing/SmmLanding.astro";
import { smmLanding } from "../../data/smm-landing";
import { landingJsonLd } from "../../lib/landing/schema";

const lang = "en" as const;
const c = smmLanding[lang];
const CRUMB = { it: "Per social media manager", en: "For social media managers" };
---

<Layout
  lang={lang}
  slug="social-media-manager"
  title={c.title}
  description={c.description}
  ogImage={c.ogImage}
  ogAlt={c.ogAlt}
  jsonLd={landingJsonLd({
    lang,
    site: Astro.site ?? new URL("https://alpacode.it"),
    crumbs: [{ name: CRUMB[lang], slug: "social-media-manager" }],
    faq: c.qa.items,
  })}
  themeColor="#f0f3f9"
>
  <SmmLanding lang={lang} />
</Layout>
