---
/* A volt band that crosses the page, the words on repeat. */
interface Props {
  words: string[];
}
const { words } = Astro.props;
const run = [...words, ...words, ...words, ...words];
---

<div class="fx-band-clip" aria-hidden="true">
  <div class="fx-band">
    <div class="fx-band-track" data-band>{run.map((w) => <span>{w} ·</span>)}</div>
  </div>
</div>
