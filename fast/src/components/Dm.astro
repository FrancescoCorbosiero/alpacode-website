---
/* The way to answer: the checkout when there is one, the keyword in a
   DM always (WhatsApp with it already typed; Instagram once the handle
   is set). */
import { ig, wa } from "../data/site";

interface Props {
  keyword: string;
  /** What WhatsApp has typed (defaults to the keyword). */
  text?: string;
  buy?: { href: string; label: string } | null;
  note?: string;
}
const { keyword, text = keyword, buy = null, note } = Astro.props;
---

<div class="fx-dm">
  {
    buy && (
      <a class="fx-btn" href={buy.href} data-umami-event="checkout" data-umami-event-keyword={keyword}>
        {buy.label} <span aria-hidden="true">→</span>
      </a>
    )
  }
  <a
    class:list={["fx-btn", { "fx-btn--ghost": buy }]}
    href={wa(text)}
    target="_blank"
    rel="noopener"
    data-umami-event="dm"
    data-umami-event-keyword={keyword}
    data-umami-event-channel="whatsapp"
  >
    Scrivi <span class="fx-kw">{keyword}</span> su WhatsApp
  </a>
  {
    ig && (
      <a
        class="fx-btn fx-btn--ghost"
        href={ig}
        target="_blank"
        rel="noopener"
        data-umami-event="dm"
        data-umami-event-keyword={keyword}
        data-umami-event-channel="instagram"
      >
        o in DM su Instagram
      </a>
    )
  }
  {note && <p class="fx-dm-note">{note}</p>}
</div>
