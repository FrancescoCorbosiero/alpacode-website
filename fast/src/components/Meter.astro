---
/* /ai: the needle goes from fear to leverage as the page scrolls
   (lib/motion.ts). Without motion it rests on LEVA, the three beats
   read in order. */
import { METER } from "../data/products";

const ticks = Array.from({ length: 11 }, (_, i) => {
  const a = Math.PI * (1 - i / 10);
  const at = (r: number) => [200 + r * Math.cos(a), 200 - r * Math.sin(a)].map((n) => n.toFixed(1));
  const [x1, y1] = at(134);
  const [x2, y2] = at(150);
  return { x1, y1, x2, y2 };
});
---

<section class="fx-scene fx-meter" data-scene="meter" data-bar-hide style="--len:3" aria-labelledby="meter-title">
  <div class="fx-stage">
    <div class="fx-wrap fx-meter-grid">
      <div class="fx-gauge" aria-hidden="true">
        <div class="fx-gauge-dial">
          <svg viewBox="0 0 400 220">
            <defs>
              <linearGradient id="fx-heat" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0" stop-color="#ff5a3c"></stop>
                <stop offset="0.5" stop-color="#f5b83d"></stop>
                <stop offset="1" stop-color="#d4ff3a"></stop>
              </linearGradient>
            </defs>
            <path class="fx-gauge-arc" d="M30 200 A170 170 0 0 1 370 200"></path>
            {ticks.map((t) => <line class="fx-gauge-tick" x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
            <g class="fx-needle" transform="rotate(80 200 200)">
              <line x1="200" y1="200" x2="200" y2="58"></line>
              <circle cx="200" cy="200" r="14"></circle>
            </g>
          </svg>
          <span class="fx-gauge-l">PAURA</span>
          <span class="fx-gauge-r">LEVA</span>
        </div>
        <b class="fx-gauge-word" data-word>{METER[METER.length - 1].word}</b>
      </div>
      <ol class="fx-beats">
        {
          METER.map((m, i) => (
            <li class="fx-beat">
              <span class="fx-sticker fx-sticker--ghost fx-beat-k">{m.word}</span>
              <h3 id={i === 0 ? "meter-title" : undefined}>{m.t}</h3>
              <p>{m.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
