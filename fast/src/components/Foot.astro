---
import { STUDIO } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="fx-foot" data-bar-hide>
  <div class="fx-wrap">
    <p>
      Alpacode FAST è un progetto di {STUDIO.name} · P.IVA {STUDIO.vat} · © {year}
    </p>
    <nav aria-label="Link">
      <a href={STUDIO.url}>alpacode.it</a>
      <a href={`${STUDIO.url}/privacy/`}>Privacy</a>
      <a href={`${STUDIO.url}/cookie/`}>Cookie</a>
      <a href={`${STUDIO.url}/termini/`}>Termini</a>
      <a href={`mailto:${STUDIO.email}`}>{STUDIO.email}</a>
    </nav>
  </div>
</footer>
