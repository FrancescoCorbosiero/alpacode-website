---
import { wa } from "../data/site";

interface Props {
  keyword: string;
}
const { keyword } = Astro.props;
---

<header class="fx-top">
  <div class="fx-wrap">
    <a class="fx-brand" href="/" aria-label="Alpacode FAST">ALPACODE <span class="fx-sticker">FAST</span></a>
    <a
      class="fx-top-dm"
      href={wa(keyword)}
      target="_blank"
      rel="noopener"
      data-umami-event="dm"
      data-umami-event-keyword={keyword}
      data-umami-event-channel="whatsapp-top"
    >
      <span class="fx-top-dm-l">Scrivi in DM</span>
      <span class="fx-kw">{keyword}</span>
    </a>
  </div>
</header>
