---
/* The chooser: one card per audience (data/doors.ts). */
import { CHOOSER, DOORS } from "../data/doors";
---

<section class="fx-section" id="scegli">
  <div class="fx-wrap">
    <div class="fx-choose-head" data-rise>
      <span class="fx-hand">da dove parti?</span>
      <h2 class="fx-title">Scegli la tua porta.</h2>
    </div>
    <ul class="fx-cards">
      {
        CHOOSER.map((id) => {
          const d = DOORS[id];
          return (
            <li>
              <a class="fx-card" href={d.path} data-card>
                <span class="fx-card-who">{d.who}</span>
                <span class="fx-card-what">{d.what}</span>
                <span class="fx-card-kw">
                  In DM: <span class="fx-kw" data-scramble>{d.keyword}</span>
                </span>
                <span class="fx-card-go" aria-hidden="true">→</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
