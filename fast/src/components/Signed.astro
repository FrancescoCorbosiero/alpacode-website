---
/* The signature: the studio behind FAST, and its real work. */
import { studio } from "../data/site";

interface Props {
  door: string;
}
const { door } = Astro.props;
---

<section class="fx-section">
  <div class="fx-wrap">
    <div class="fx-signed" data-rise>
      <div>
        <div class="fx-signed-mark">
          <strong>ALPACODE</strong>
          <span class="fx-hand">firmato</span>
        </div>
        <p>
          Dietro FAST c'è uno studio vero: facciamo siti e software per lavoro. Le guide le scriviamo con quello che
          usiamo ogni giorno, per i nostri clienti.
        </p>
      </div>
      <a class="fx-btn fx-btn--ghost" href={studio("/lavori/", door)}>Guarda i lavori <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
