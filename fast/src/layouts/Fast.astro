---
import "@fontsource/archivo-black/400.css";
import "@fontsource/manrope/500.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/manrope/800.css";
import "@fontsource/caveat/600.css";
import "../styles/fast.css";
import type { Door } from "../data/doors";
import Top from "../components/Top.astro";
import Foot from "../components/Foot.astro";
import Bar from "../components/Bar.astro";

interface Props {
  door: Door;
  /** For pages that aren't a door (the 404). */
  title?: string;
  noindex?: boolean;
}
const { door, title = door.meta.title, noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://fast.alpacode.it");
const canonical = new URL(door.path, site).href;
const og = new URL(door.meta.og, site).href;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiId = import.meta.env.PUBLIC_UMAMI_FAST_ID;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={door.meta.description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0e14" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alpacode FAST" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={door.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={door.said} />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={door.meta.description} />
    <meta name="twitter:image" content={og} />
    {
      /* Umami is cookieless: it ships when both values are set at build. */
      umamiSrc && umamiId && <script is:inline defer src={umamiSrc} data-website-id={umamiId} />
    }
  </head>
  <body>
    <Top keyword={door.keyword} />
    <main>
      <slot />
    </main>
    <Foot />
    <Bar keyword={door.keyword} />
    <script>
      import "../lib/motion";
    </script>
  </body>
</html>
