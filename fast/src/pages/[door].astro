---
/* CODE, BIO, AMICO — doors that make the case in three punches and
   hand over to the studio's page for that audience. */
import Fast from "../layouts/Fast.astro";
import Hero from "../components/Hero.astro";
import Dm from "../components/Dm.astro";
import Signed from "../components/Signed.astro";
import { BRIDGES, DOORS, type Door } from "../data/doors";
import { studio } from "../data/site";

export function getStaticPaths() {
  return BRIDGES.map((id) => ({ params: { door: id }, props: { door: DOORS[id] } }));
}

const { door } = Astro.props as { door: Door };
const go = door.studio ? studio(door.studio.path, door.id) : "/";
---

<Fast door={door}>
  <Hero door={door}>
    <Dm keyword={door.keyword} />
    <a class="fx-link fx-hero-more" href={go}>{door.studio?.label} <span aria-hidden="true">→</span></a>
  </Hero>

  <section class="fx-section">
    <div class="fx-wrap fx-split">
      <div class="fx-split-side" data-rise>
        <span class="fx-hand">in tre colpi</span>
        <h2 class="fx-title">{door.pointsTitle}</h2>
      </div>
      <ol class="fx-punches">
        {
          door.points?.map((p, i) => (
            <li class="fx-punch" data-rise>
              <b>{i + 1}</b>
              <span>{p}</span>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="fx-wrap fx-go" data-rise>
      <a class="fx-btn" href={go}>{door.studio?.label} <span aria-hidden="true">→</span></a>
      <p>{door.studio?.note}</p>
    </div>
  </section>

  <Signed door={door.id} />
</Fast>
