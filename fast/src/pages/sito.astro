---
/* SITO — the site guide (22 €) and its marketing module (+48 €). */
import Fast from "../layouts/Fast.astro";
import Hero from "../components/Hero.astro";
import Dm from "../components/Dm.astro";
import Band from "../components/Band.astro";
import Chapters from "../components/Chapters.astro";
import Offers from "../components/Offers.astro";
import Signed from "../components/Signed.astro";
import Qa from "../components/Qa.astro";
import StudioDoor from "../components/StudioDoor.astro";
import { DOORS } from "../data/doors";
import { GUIDE, MARKETING, SITO_OFFERS, SITO_QA } from "../data/products";
import { euro, studio } from "../data/site";

const door = DOORS.sito;
const guide = SITO_OFFERS[0];
---

<Fast door={door}>
  <Hero door={door}>
    <Dm
      keyword={door.keyword}
      buy={guide.checkout ? { href: guide.checkout, label: `Compra la guida · ${euro(GUIDE.price)}` } : null}
    />
    <a class="fx-link fx-hero-more" href="#scegli">Guida + Marketing: {euro(GUIDE.price + MARKETING.price)} <span aria-hidden="true">↓</span></a>
  </Hero>

  <section class="fx-section">
    <div class="fx-wrap fx-split">
      <div class="fx-split-side" data-rise>
        <span class="fx-hand">cosa c'è dentro</span>
        <h2 class="fx-title">Dal niente al sito online.</h2>
        <p class="fx-lede">Quattro capitoli, nell'ordine in cui ti servono. Senza scrivere codice.</p>
      </div>
      <Chapters items={GUIDE.chapters} />
    </div>
  </section>

  <Band words={["Il sito: 0 €", `La guida: ${euro(GUIDE.price)}`, "Scrivi SITO"]} />

  <section class="fx-section">
    <div class="fx-wrap">
      <div class="fx-addon" data-rise>
        <span class="fx-sticker">+{euro(MARKETING.price)}</span>
        <h2 class="fx-title">{MARKETING.title}</h2>
        <Chapters items={MARKETING.chapters} />
      </div>
    </div>
  </section>

  <section class="fx-section" id="scegli">
    <div class="fx-wrap">
      <h2 class="fx-title" data-rise>Scegli come partire.</h2>
      <Offers offers={SITO_OFFERS} keyword={door.keyword} />
    </div>
  </section>

  <Signed door="sito" />
  <Qa title="Prima che tu lo chieda." items={SITO_QA} />
  <StudioDoor
    title="Non hai tempo? Te lo facciamo noi."
    text="Lo studio fa il tuo sito, con dominio, hosting e un anno di manutenzione."
    href={studio("/servizi/", "sito")}
    label="Lo studio"
  />
</Fast>
