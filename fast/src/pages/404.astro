---
import Fast from "../layouts/Fast.astro";
import Dm from "../components/Dm.astro";
import Chooser from "../components/Chooser.astro";
import { DOORS } from "../data/doors";

const door = DOORS.home;
---

<Fast door={door} title="Pagina non trovata — Alpacode FAST" noindex>
  <section class="fx-hero" data-hero>
    <span class="fx-ghost" aria-hidden="true">404</span>
    <div class="fx-wrap">
      <span class="fx-sticker" data-intro style="--i:0">404</span>
      <h1 class="fx-hook" data-intro style="--i:1">Questa pagina non c'è. <span class="fx-volt">Le porte sì.</span></h1>
      <div class="fx-hero-act" data-intro style="--i:2">
        <Dm keyword={door.keyword} />
      </div>
    </div>
  </section>
  <Chooser />
</Fast>
