---
/* AI — the crash course for freelancers, and the site they build in it:
   hosted by the studio, free the first year. */
import Fast from "../layouts/Fast.astro";
import Hero from "../components/Hero.astro";
import Dm from "../components/Dm.astro";
import Band from "../components/Band.astro";
import Meter from "../components/Meter.astro";
import Chapters from "../components/Chapters.astro";
import Signed from "../components/Signed.astro";
import Qa from "../components/Qa.astro";
import StudioDoor from "../components/StudioDoor.astro";
import { DOORS } from "../data/doors";
import { AI_QA, COURSE, HOSTING } from "../data/products";
import { euro, studio } from "../data/site";

const door = DOORS.ai;
const priced = COURSE.price !== null;
const qa = [
  ...AI_QA,
  {
    q: "Quanto costa il corso?",
    a: priced
      ? `${euro(COURSE.price as number)}. E il sito che costruisci, il primo anno, è gratis.`
      : "Scrivi AI in DM: ti mandiamo il programma e il prezzo.",
  },
];
---

<Fast door={door}>
  <Hero door={door}>
    <Dm
      keyword={door.keyword}
      buy={priced && COURSE.checkout ? { href: COURSE.checkout, label: `Iscriviti · ${euro(COURSE.price as number)}` } : null}
      note={priced ? undefined : "Ti mandiamo il programma del corso."}
    />
  </Hero>

  <Meter />

  <section class="fx-section">
    <div class="fx-wrap fx-split">
      <div class="fx-split-side" data-rise>
        <span class="fx-hand">il crash course</span>
        <h2 class="fx-title">{COURSE.name}.</h2>
        <p class="fx-lede">Quattro moduli: dal primo compito che le dai al lavoro nuovo che ti porta.</p>
      </div>
      <Chapters items={COURSE.modules} />
    </div>
  </section>

  <section class="fx-section">
    <div class="fx-wrap">
      <div class="fx-free" data-rise>
        <div>
          <h2 class="fx-title">Perché pagare migliaia di euro per un sito?</h2>
          <p>Nel corso lo costruisci tu, con l'AI. Lo ospitiamo noi: il primo anno è gratis, paghi solo dal secondo.</p>
        </div>
        <ul class="fx-years">
          <li><span>Primo anno</span><b>Gratis</b></li>
          <li>
            <span>Dal secondo anno</span><b>{HOSTING.yearTwo !== null ? `${euro(HOSTING.yearTwo)}/anno` : "il canone annuale"}</b>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <Band words={["Non temere l'AI", "Cavalcala", "Scrivi AI"]} />
  <Qa title="Prima che tu lo chieda." items={qa} />
  <Signed door="ai" />
  <StudioDoor
    title="Hai clienti tuoi?"
    text="Porta loro il digitale senza farlo tu: il programma partner dello studio."
    href={studio("/partner/", "ai")}
    label="Il programma partner"
  />
</Fast>
