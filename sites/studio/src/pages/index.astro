---
/* The studio's home: the hook, "in chi ti identifichi?", the three
   verbs on a phone (Journey), the packages and the products, the work. */
import Studio from "../layouts/Studio.astro";
import Hero from "../components/Hero.astro";
import Feed from "../components/Feed.astro";
import Band from "../components/Band.astro";
import Readers from "../components/Readers.astro";
import Journey from "../components/Journey.astro";
import Proof from "../components/Proof.astro";
import Cta from "../components/Cta.astro";
import { PAGES } from "../data/pages";
import { PACKAGES } from "../data/packages";
import { PRODUCTS } from "../data/products";
import { euro } from "../data/site";
import { organization } from "../lib/schema";

const head = PAGES.home;
---

<Studio title={head.meta.title} description={head.meta.description} og={head.meta.og} ogAlt={head.said} jsonld={[organization()]}>
  <Hero head={head}>
    <a class="fx-btn" href="/contatti/">Parliamone <span aria-hidden="true">→</span></a>
    <a class="fx-link fx-hero-more" href="#per-chi">Oppure dicci chi sei <span aria-hidden="true">↓</span></a>
    <Feed slot="visual" />
  </Hero>

  <Band words={["Farsi vedere", "Farsi ricordare", "Farsi scegliere"]} />

  <Readers />

  <Journey />

  <section class="fx-section fx-paper">
    <div class="fx-wrap">
      <div class="fx-split">
        <div class="fx-split-side" data-reveal>
          <span class="fx-hand">i pacchetti</span>
          <h2 class="fx-title">Pronti da partire.</h2>
          <p class="fx-lede">Un contenuto definito e tempi chiari: i social, il brand, una campagna. Il punto da cui cominciare.</p>
          <a class="fx-btn" href="/pacchetti/">Guarda i pacchetti <span aria-hidden="true">→</span></a>
        </div>
        <ul class="fx-chapters">
          {
            PACKAGES.map((p) => (
              <li class="fx-chapter" data-reveal>
                <h3>{p.name}</h3>
                <p>{p.blurb}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="fx-section">
    <div class="fx-wrap">
      <div class="fx-choose-head" data-reveal>
        <span class="fx-hand">fai da te</span>
        <h2 class="fx-title">Il metodo, in mano tua.</h2>
      </div>
      <ul class="fx-products">
        {
          PRODUCTS.map((p) => (
            <li data-reveal>
              <a class="fx-product" href={`/prodotti/${p.slug}/`} style={`--ac:${p.accent}`}>
                <span class="fx-product-kind">{p.kind}</span>
                <h3>{p.name}</h3>
                <p>{p.line}</p>
                <span class="fx-product-from">
                  {p.from !== null ? (
                    <>
                      <small>da</small> {euro(p.from)}
                    </>
                  ) : (
                    <small>Prezzo in arrivo</small>
                  )}
                </span>
                <span class="fx-product-go">Scopri →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Proof where="home" />
  <Cta />
</Studio>
