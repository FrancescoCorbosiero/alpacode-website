---
import Studio from "../layouts/Studio.astro";
import Readers from "../components/Readers.astro";
---

<Studio title="Pagina non trovata — Alpacode Studio" description="Questa pagina non c'è. Il resto sì." noindex>
  <section class="fx-hero fx-hero--solo" data-hero>
    <span class="fx-ghost" aria-hidden="true">404</span>
    <div class="fx-wrap">
      <span class="fx-sticker" data-intro style="--i:0">404</span>
      <h1 class="fx-hook" data-intro style="--i:1">Questa pagina non c'è. <span class="fx-volt">Il resto sì.</span></h1>
      <div class="fx-hero-act" data-intro style="--i:2">
        <a class="fx-btn" href="/">Torna allo studio <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <Readers kicker="da dove ripartiamo?" />
</Studio>
