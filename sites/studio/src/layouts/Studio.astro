---
/* The studio's page: head and meta, the header, the footer, the
   scripts. Every page passes its meta (data/pages.ts) or its own. */
import "@fontsource/archivo-black/400.css";
import "@fontsource/manrope/500.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/manrope/800.css";
import "@fontsource/caveat/600.css";
import "../engine/core/core.css";
import "../engine/effects/stage.css";
import "../engine/effects/meter.css";
import "../engine/effects/feed.css";
import "../engine/effects/scribble.css";
import "../engine/effects/type.css";
import "../engine/effects/grow.css";
import "../engine/effects/stamp.css";
import "../engine/effects/tilt.css";
import "../styles/studio.css";
import Top from "../components/Top.astro";
import Foot from "../components/Foot.astro";
import { STUDIO } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Share card, from public/ ("/og-studio.png"). */
  og?: string;
  ogAlt?: string;
  noindex?: boolean;
  /** Structured data for the page (schema.org objects). */
  jsonld?: Record<string, unknown>[];
}
const { title, description, og = "/og-studio.png", ogAlt = STUDIO.name, noindex = false, jsonld = [] } = Astro.props;
const site = Astro.site ?? new URL(STUDIO.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ogUrl = new URL(og, site).href;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiId = import.meta.env.PUBLIC_UMAMI_STUDIO_ID;
// Ad tags ship only when set, and load only after consent (lib/consent.ts).
const pixels = {
  meta: import.meta.env.PUBLIC_META_PIXEL_ID ?? "",
  gads: import.meta.env.PUBLIC_GADS_ID ?? "",
};
const hasPixels = Boolean(pixels.meta || pixels.gads);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0e14" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={STUDIO.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {jsonld.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
    {
      /* Umami is cookieless: it ships when both values are set at build,
         without a banner. */
      umamiSrc && umamiId && <script is:inline defer src={umamiSrc} data-website-id={umamiId} />
    }
  </head>
  <body data-pixels={hasPixels ? JSON.stringify(pixels) : undefined}>
    <a class="fx-skip" href="#main">Vai al contenuto</a>
    <Top />
    <main id="main">
      <slot />
    </main>
    <Foot />
    <slot name="after" />
    <script>
      import "../engine";
      import "../lib/checkout";
      import "../lib/consent";
    </script>
  </body>
</html>
