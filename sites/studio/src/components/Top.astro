---
/* The header: the lockup (ALPACODE + the studio's sticker), the pages,
   the way to write, and the link to alpacode.it (sites and software).
   On a phone the pages fold into a <details> menu: no script needed. */
import { NAV, STUDIO, house } from "../data/site";

const path = Astro.url.pathname;
const current = (href: string) => path === href || path.startsWith(href);
---

<header class="fx-top">
  <div class="fx-wrap fx-top-row">
    <a class="fx-brand" href="/" aria-label={`${STUDIO.name}, home`}>
      ALPACODE <span class="fx-sticker">{STUDIO.tag}</span>
    </a>
    <nav class="fx-nav" aria-label="Pagine">
      {
        NAV.map((n) => (
          <a href={n.href} aria-current={current(n.href) ? "page" : undefined}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <div class="fx-top-end">
      <a class="fx-top-house" href={house("/", "header")}>
        <span class="fx-top-house-l">Siti e software:</span> alpacode.it <span aria-hidden="true">↗</span>
      </a>
      <a class="fx-btn fx-btn--sm" href="/contatti/">Parliamone</a>
      <details class="fx-menu">
        <summary aria-label="Menu"><span></span><span></span></summary>
        <div class="fx-menu-panel">
          {
            NAV.map((n) => (
              <a href={n.href} aria-current={current(n.href) ? "page" : undefined}>
                {n.label}
              </a>
            ))
          }
          <a class="fx-menu-house" href={house("/", "menu")}>Siti e software: alpacode.it ↗</a>
        </div>
      </details>
    </div>
  </div>
</header>
