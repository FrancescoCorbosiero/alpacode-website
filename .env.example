# ---------- Mail: how the forms reach info@alpacode.it ----------
# Two ways; the first that is set wins. With NEITHER, every form answers ok
# but nothing is sent: the server only logs it (grep "NOT SENT" in
# `docker compose logs`). After editing this file: docker compose up -d --build
#
# 1) SMTP — the simplest: the mailbox's own server (the provider that hosts
#    info@alpacode.it gives host, port and the password; some ask for an
#    "app password"). The visitors' auto-replies leave like any mail from
#    that box.
SMTP_HOST=
# 465 = TLS from the start, 587 = STARTTLS.
SMTP_PORT=465
# Usually the full address (default: CONTACT_FROM_EMAIL).
SMTP_USER=
SMTP_PASS=
#
# 2) AWS SES — below. Auto-replies reach the visitors only once the SES
#    account is out of the sandbox (in it, only verified addresses receive).
#
# The person who writes gets an auto-reply in the site's look (alpacode.it:
# formal, IT/EN; the studio: its voice). 0 = off.
CONTACT_AUTOREPLY=1

# SES region, e.g. eu-west-1 / eu-central-1 / us-east-1. Must be the region
# where the sender identity (alpacode.it or the address) is verified:
# identities are per region. SES keeps checking a domain identity's three
# DKIM CNAMEs (<token>._domainkey); without them sends fail with "Email
# address is not verified". Moving the DNS (e.g. to Cloudflare, whose
# import scan misses them) can drop them silently. On Cloudflare they must
# be "DNS only", not proxied.
AWS_REGION=

# IAM credentials with the ses:SendEmail permission. Leave empty if the host
# provides an IAM role / instance profile (the SDK picks those up itself).
# These are an IAM user's ACCESS KEYS (IAM → Users → Security credentials →
# Create access key), not SES "SMTP credentials": the SMTP password is not a
# secret access key and the API rejects it. Minimal policy:
#   { "Effect": "Allow", "Action": "ses:SendEmail", "Resource": "*" }
# After editing this file run `docker compose up -d` (a restart keeps the old
# environment). Failed sends are logged with the cause and the fix:
#   docker compose logs alpacode-website | grep "\[contact\]"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Recipient of contact submissions (defaults to info@alpacode.it).
CONTACT_TO_EMAIL=info@alpacode.it

# SES-verified sender identity (must be verified in your SES account).
CONTACT_FROM_EMAIL=info@alpacode.it

# --- Referral program «Segnala un amico» (/voucher, /api/referral) ---
# Secret for referral codes: the 5-char suffix of MARIO-7K2QX is an HMAC of
# the referrer's email, so the same email always gets the same link. Use a
# long random value (`openssl rand -hex 32`) and don't change it afterwards:
# a new secret means new codes for everyone (old links keep opening an
# invite, but their referrers can't regenerate them). If the program ran
# before on voucher.alpacode.it, reuse that REFERRAL_SECRET.
REFERRAL_SECRET=
# Ledger of every accepted submission (one JSON per line): it powers the
# "already referred" check and the referrer lookup on invite requests.
# docker-compose mounts the referral-data volume at /app/data. "off" disables it.
REFERRAL_LEDGER=/app/data/referrals.jsonl
# Also email referrers their personal link (needs SES out of the sandbox,
# since recipients are arbitrary addresses). 1 = on.
REFERRAL_CONFIRM_EMAILS=0
# Origin of the invite links the API hands out. Empty = the site's own
# (https://alpacode.it); set it on a staging host.
SITE_URL=

# --- Booking (cal.com) ---
# Booking link: a full URL (origin is taken from it) or a bare username/event.
# Inlined at BUILD time (docker compose passes it as a build arg), then rebuild.
PUBLIC_CALCOM_LINK=https://cal.eu/alpacode/30min
# Optional overrides (only if auto-detection is wrong for your instance):
#   PUBLIC_CALCOM_ORIGIN=https://cal.eu
#   PUBLIC_CALCOM_EMBED_JS=https://cal.eu/embed/embed.js

# --- Analytics (Umami, self-hosted) ---
# Build-time. Leave empty to ship no analytics. After bringing up Umami (see
# deploy/umami.docker-compose.yml) and creating a website in its dashboard,
# set both, then rebuild. Loads only after the visitor accepts analytics.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_ID=

# --- Docker deploy (behind caddy-docker-proxy) ---
# Domain Caddy routes to this container and issues TLS for.
# Point its DNS A/AAAA record at the VPS before first boot.
SITE_DOMAIN=alpacode.it
# Note: the ACME/Let's Encrypt email is configured once on the Caddy proxy
# stack itself (ACME_EMAIL there), not here.

# ---------- Alpacode Studio (sites/studio/, its own container) ----------
# Comes up with the rest (docker compose up -d --build).
# Point the domain's DNS A/AAAA record at the VPS first (or a wildcard
# *.alpacode.it, which covers every compartment to come).
STUDIO_DOMAIN=studio.alpacode.it
# Umami website id for the studio (same Umami instance as PUBLIC_UMAMI_SRC).
# Cookieless: it loads without a banner.
PUBLIC_UMAMI_STUDIO_ID=
# Ad tags, build-time. Empty = no tag and no cookie banner. Set = the
# banner asks once, and the tags load only after a yes.
#   Meta Pixel id (digits) and Google Ads id (AW-XXXXXXXXX).
PUBLIC_META_PIXEL_ID=
PUBLIC_GADS_ID=
# Buying on the site — sites/studio/README.md, "Buying on the site".
# The orders the payment providers notify (one JSON per line, on the
# studio-data volume). "off" disables it.
ORDERS_LEDGER=/app/data/orders.jsonl
# Lemon Squeezy: Settings → Webhooks → signing secret; webhook URL
#   https://studio.alpacode.it/api/checkout/lemonsqueezy (event order_created).
LEMONSQUEEZY_WEBHOOK_SECRET=
# Stripe: Developers → Webhooks → signing secret (whsec_…); webhook URL
#   https://studio.alpacode.it/api/checkout/stripe (checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
# Gumroad: Settings → Advanced → Ping URL
#   https://studio.alpacode.it/api/checkout/gumroad?key=<GUMROAD_WEBHOOK_KEY>
# (Gumroad's ping has no signature: the key in the URL is the check). The
# seller id, if set, is checked too.
GUMROAD_WEBHOOK_KEY=
GUMROAD_SELLER_ID=
