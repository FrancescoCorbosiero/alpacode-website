# Contact form delivery via AWS SES (optional).
# Without AWS_REGION the /api/contact route logs the submission and returns
# success, so the form is testable locally without any AWS credentials.

# SES region, e.g. eu-west-1 / eu-central-1 / us-east-1.
AWS_REGION=

# IAM credentials with the ses:SendEmail permission. Leave empty if the host
# provides an IAM role / instance profile (the SDK picks those up itself).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Recipient of contact submissions (defaults to info@alpacode.it).
CONTACT_TO_EMAIL=info@alpacode.it

# SES-verified sender identity (must be verified in your SES account).
CONTACT_FROM_EMAIL=info@alpacode.it

# --- Booking (cal.com) ---
# Booking link: a full URL (origin is taken from it) or a bare username/event.
# Inlined at BUILD time (docker compose passes it as a build arg), then rebuild.
PUBLIC_CALCOM_LINK=https://cal.eu/alpacode/30min
# Optional overrides (only if auto-detection is wrong for your instance):
#   PUBLIC_CALCOM_ORIGIN=https://cal.eu
#   PUBLIC_CALCOM_EMBED_JS=https://cal.eu/embed/embed.js

# --- Analytics (Umami, self-hosted) ---
# Build-time. Leave empty to ship no analytics. After bringing up Umami (see
# deploy/umami.docker-compose.yml) and creating a website in its dashboard,
# set both, then rebuild. Loads only after the visitor accepts analytics.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_ID=

# --- Docker deploy (behind caddy-docker-proxy) ---
# Domain Caddy routes to this container and issues TLS for.
# Point its DNS A/AAAA record at the VPS before first boot.
SITE_DOMAIN=alpacode.it
# Note: the ACME/Let's Encrypt email is configured once on the Caddy proxy
# stack itself (ACME_EMAIL there), not here.
