# Contact form delivery (optional).
# Without RESEND_API_KEY the /api/contact route logs the submission and
# returns success, so the form is testable locally without any secret.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where contact submissions are delivered (defaults to ciao@alpacode.it).
CONTACT_TO_EMAIL=ciao@alpacode.it

# Verified Resend sender (defaults to Resend's onboarding address).
CONTACT_FROM_EMAIL="Alpacode <onboarding@resend.dev>"

# --- Docker deploy (behind caddy-docker-proxy) ---
# Domain Caddy routes to this container and issues TLS for.
# Point its DNS A/AAAA record at the VPS before first boot.
SITE_DOMAIN=alpacode.it
# Note: the ACME/Let's Encrypt email is configured once on the Caddy proxy
# stack itself (ACME_EMAIL there), not here.
