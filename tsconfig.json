{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": { "@shared/*": ["./shared/*"] }
  },
  "include": [".astro/types.d.ts", "src/**/*", "shared/**/*"],
  "exclude": ["dist", ".vercel", ".astro", "design_reference", "node_modules", "sites"]
}
